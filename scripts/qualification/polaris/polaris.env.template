# CLIO Polaris kit settings (bash, sourced by every kit script).
# Copy once:  cp scripts/qualification/polaris/polaris.env.template ~/.clio-polaris.env
# then set PBS_ACCOUNT. Every other value has a working default for ALCF Polaris.
# Point CLIO_POLARIS_ENV at another file to keep several configurations.

# --- Required -----------------------------------------------------------------
PBS_ACCOUNT="${PBS_ACCOUNT:-CHANGE_ME}"          # ALCF allocation name (qsub -A)

# --- Project storage (Eagle; never $HOME: 50 GB / small inode quota) ------------
EAGLE_PROJECT="${EAGLE_PROJECT:-$PBS_ACCOUNT}"     # /eagle/<project>
# /eagle is a symlink to /lus/eagle/projects; CLIO's native services refuse symlinked paths.
ROOT="${ROOT:-$(readlink -f "/eagle/$EAGLE_PROJECT" 2>/dev/null || echo "/eagle/$EAGLE_PROJECT")/$USER/clio-polaris-2026-10}"
INODE_MIN="${INODE_MIN:-400000}"                 # free project inodes required before installs
SPACE_MIN_GB="${SPACE_MIN_GB:-150}"              # free project space required (8B 17.6 GB / 30B 58.5 GB + envs)

# --- PBS -----------------------------------------------------------------------
PBS_QUEUE="${PBS_QUEUE:-capacity}"               # 1-4 nodes, long walltime. debug = <=1 h smoke.
PBS_WALLTIME="${PBS_WALLTIME:-06:00:00}"
TEARDOWN_MARGIN_S="${TEARDOWN_MARGIN_S:-900}"     # PBS gives no pre-walltime signal: stop this early

# --- Code ------------------------------------------------------------------------
BRANCH="${BRANCH:-claude/epic-hopper-6s2vhn}"
GITHUB="${GITHUB:-https://github.com}"
# Attention connector: CLIO's pin (native_vllm.CONNECTOR_REVISION) + the one-line build fix.
CONNECTOR_REV="${CONNECTOR_REV:-95ab2acd6fe1be74ad9a3fa2aca1ecbee60a6284}"
EXPERIMENTS_REV="${EXPERIMENTS_REV:-ebe17be1a837953d4339e1bf28fdaff17b035b47}"    # spotter-ai-genesis/experiments (attention spec + chains)

# --- Tools (pinned) ------------------------------------------------------------------
UV_VERSION="${UV_VERSION:-0.11.32}"
NODE_VERSION="${NODE_VERSION:-22.22.0}"
PNPM_VERSION="${PNPM_VERSION:-9.15.9}"
CLIO_KIT_VERSION="${CLIO_KIT_VERSION:-2.10.6}"     # the MCP launcher CLIO spawns plugin servers through

# --- Network (compute nodes reach the internet only through the ALCF proxy) ----------
ALCF_PROXY="${ALCF_PROXY:-http://proxy.alcf.anl.gov:3128}"

# --- Modules (only FLOWCEPT_VARIANT=managed needs them: Apptainer; native needs none) ------
# One module command per line, run as `module <line>`; failures are reported, not fatal.
POLARIS_MODULES="${POLARIS_MODULES:-use /soft/modulefiles
load spack-pe-base
load apptainer}"
# Optional NVIDIA forward-compat libraries if the node driver is older than vLLM's CUDA
# (A100 supports forward compatibility). Leave empty unless 00_preflight says so.
CUDA_COMPAT_DIR="${CUDA_COMPAT_DIR:-}"

# --- Model -------------------------------------------------------------------------
HF_HOME="${HF_HOME:-$ROOT/hf}"
HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
# Stage 1 (default): Granite 4.2-8B on ONE A100, so the attention capture never splits across
#   GPUs. Same chat template and tokenizer as the 30B (byte-identical), dense, 128k context.
# Stage 2, after stage 1 passes: MODEL_STAGE=2 serves Granite 4.2-30B on two A100s (TP=2,
#   about 40-50k tokens of context; capture under tensor parallelism is unproven on CUDA).
MODEL_STAGE="${MODEL_STAGE:-1}"
case "$MODEL_STAGE" in
  2) _stage_repo=ibm-granite/granite-4.2-30b; _stage_rev=9e668ce1c538387ef24d3644e9b0606647762636; _stage_tp=2 ;;
  *) _stage_repo=ibm-granite/granite-4.2-8b; _stage_rev=a7042144125ce5ae64f89610e8289647fc000b9a; _stage_tp=1 ;;
esac
MODEL_REPO="${MODEL_REPO:-$_stage_repo}"
MODEL_REVISION="${MODEL_REVISION:-$_stage_rev}"
MODEL_PATH="${MODEL_PATH:-}"                     # empty: the hub snapshot, else CLIO's download

# --- Services (all deployed BY CLIO through its REST API) -----------------------------
CLIO_PORT="${CLIO_PORT:-8100}"                   # loopback only; a busy port picks a free one
FLOWCEPT_VARIANT="${FLOWCEPT_VARIANT:-native}"   # native: prebuilt Valkey (glibc 2.34+) + verified suse15 MongoDB; nothing compiled. managed = Apptainer databases
FLOWCEPT_PORT="${FLOWCEPT_PORT:-8008}"
FLOWCEPT_REDIS_PORT="${FLOWCEPT_REDIS_PORT:-16379}"
FLOWCEPT_MONGO_PORT="${FLOWCEPT_MONGO_PORT:-37017}"
VLLM_VARIANT="${VLLM_VARIANT:-native-cuda-attention}"
VLLM_TP="${VLLM_TP:-$_stage_tp}"                 # from MODEL_STAGE: 1 GPU (8B) or 2 (30B)
VLLM_GPU_UTIL="${VLLM_GPU_UTIL:-0.9}"
VLLM_MAX_NUM_SEQS="${VLLM_MAX_NUM_SEQS:-1}"      # F055: serialize main + SPOTTER captures
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-}"     # empty: CLIO's Fit to GPU
CLIO_SEARCH_AUTO_INSTALL="${CLIO_SEARCH_AUTO_INSTALL:-1}"
# SPOTTER's model: shared = the conversation's vLLM (one GPU, serialized with the agent);
# dedicated = CLIO deploys vllm@spotter (same model, no attention connector) on SPOTTER_GPU.
SPOTTER_MODE="${SPOTTER_MODE:-shared}"
SPOTTER_GPU="${SPOTTER_GPU:-1}"                 # e.g. "2,3" with SPOTTER_TP=2
SPOTTER_TP="${SPOTTER_TP:-1}"                   # GPUs (tensor parallel) for the SPOTTER vLLM
SPOTTER_GPU_UTIL="${SPOTTER_GPU_UTIL:-0.9}"
SPOTTER_MAX_NUM_SEQS="${SPOTTER_MAX_NUM_SEQS:-4}"
SPOTTER_MAX_MODEL_LEN="${SPOTTER_MAX_MODEL_LEN:-65536}"
SPOTTER_VLLM_VARIANT="${SPOTTER_VLLM_VARIANT:-native-cuda}"  # bundled SearXNG (search works by default)

# --- OPAL ----------------------------------------------------------------------------
OPAL_AGENT="${OPAL_AGENT:-appl-core}"            # agent class id (marketplace agents/appl_core.py)
OPAL_CHAIN_AGENT="${OPAL_CHAIN_AGENT:-$OPAL_AGENT}"
OPAL_CHAIN_ID="${OPAL_CHAIN_ID:-exp32-chain-0020-hard}"
OPAL_CHAINS_CSV="${OPAL_CHAINS_CSV:-$ROOT/src/experiments/bench/opal/data/opal_chains.csv}"
OPAL_EXPORT="${OPAL_EXPORT:-$ROOT/data/opal-export-staging/Opal}"
OPAL_CONDITIONS="${OPAL_CONDITIONS:-A B}"        # B (round-5 injection) exists only for 0020-hard
OPERATOR_DIR="${OPERATOR_DIR:-$ROOT/operator}"   # chain outputs with correct answers; never a workspace
OPAL_TURN_TIMEOUT_S="${OPAL_TURN_TIMEOUT_S:-2400}"
RUN_OPAL_CHAIN="${RUN_OPAL_CHAIN:-1}"
RUN_OPAL_BROAD="${RUN_OPAL_BROAD:-1}"
