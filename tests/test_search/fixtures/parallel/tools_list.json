        {
          "annotations": {
            "destructiveHint": false,
            "idempotentHint": false,
            "openWorldHint": false,
            "readOnlyHint": false,
            "title": "Send feedback to Parallel"
          },
          "description": "Report a problem with Parallel to the Parallel team. Use it when, while\nworking with Parallel, you see any of these:\n- A Parallel tool returned an error you didn't cause: a 5xx, a timeout, or a\n  rate limit you didn't expect.\n- Results were wrong, irrelevant, stale or missing something you know exists:\n  a wrong date or number, an excerpt the page doesn't support, an empty fetch of\n  a page that has content.\n- Parallel's docs, tool descriptions and behavior disagree, or you couldn't work\n  out how to call a tool.\n- An evaluation, benchmark or comparison you ran shows Parallel doing worse than\n  expected.\nProblems you worked around count too. It isn't for mistakes in your own\nrequests, or for questions.\n\nAsk the user first. When you tell them about the problem, offer to report it\nand show what you'd send: the message and the IDs. Send it only if they agree,\nthen tell them it was sent.\n\nPut the IDs involved (search_id, extract_id, run_id) in `examples`, with a\nshort note on each. web_decisions returns no ID: put the subject and the\nquestions it answered wrongly in `message`.\n\nParallel receives only the fields you fill in, plus the account and client the\nrequest came from; nothing else from your conversation. Leave out secrets and\npersonal data.\n",
          "icons": [
            {
              "mimeType": "image/svg+xml",
              "src": "https://assets.parallel.ai/dark-parallel-avatar-270.svg",
              "theme": "light"
            },
            {
              "mimeType": "image/png",
              "sizes": [
                "270x270"
              ],
              "src": "https://assets.parallel.ai/dark-parallel-avatar-270.png",
              "theme": "light"
            },
            {
              "mimeType": "image/svg+xml",
              "src": "https://assets.parallel.ai/white-parallel-avatar-270.svg",
              "theme": "dark"
            },
            {
              "mimeType": "image/png",
              "sizes": [
                "270x270"
              ],
              "src": "https://assets.parallel.ai/white-parallel-avatar-270.png",
              "theme": "dark"
            }
          ],
          "inputSchema": {
            "properties": {
              "message": {
                "description": "What you were doing, what went wrong, and what you expected. Do not include secrets or personal data.",
                "maxLength": 4000,
                "minLength": 20,
                "title": "Message",
                "type": "string"
              },
              "category": {
                "description": "The kind of problem.",
                "enum": [
                  "results_quality",
                  "error",
                  "latency",
                  "missing_capability",
                  "docs",
                  "billing",
                  "other"
                ],
                "title": "Category",
                "type": "string"
              },
              "product": {
                "description": "The Parallel product involved.",
                "enum": [
                  "search",
                  "extract",
                  "task",
                  "findall",
                  "monitor",
                  "responses",
                  "decisions",
                  "mcp",
                  "cli",
                  "other"
                ],
                "title": "Product",
                "type": "string"
              },
              "severity": {
                "default": "degraded",
                "description": "How much the problem affected the work: blocking, degraded (a workaround was needed) or minor (noticeable, but the work went on unchanged).",
                "enum": [
                  "blocking",
                  "degraded",
                  "minor"
                ],
                "title": "Severity",
                "type": "string"
              },
              "examples": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/FeedbackExample"
                    },
                    "maxItems": 50,
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The specific requests involved, each with a short note.",
                "title": "Examples"
              },
              "expected": {
                "anyOf": [
                  {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The overall expected behavior.",
                "title": "Expected"
              },
              "actual": {
                "anyOf": [
                  {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The overall observed behavior.",
                "title": "Actual"
              }
            },
            "required": [
              "message",
              "category",
              "product"
            ],
            "type": "object",
            "$defs": {
              "FeedbackExample": {
                "properties": {
                  "id": {
                    "description": "ID of the Parallel request this example is about, such as a search_id, extract_id, task run_id, findall_id or monitor_id.",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "title": "Id",
                    "type": "string"
                  },
                  "issue": {
                    "anyOf": [
                      {
                        "maxLength": 1000,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "What was wrong with this result.",
                    "title": "Issue"
                  },
                  "expected": {
                    "anyOf": [
                      {
                        "maxLength": 1000,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "What you expected instead, such as a fact or URL Parallel missed.",
                    "title": "Expected"
                  }
                },
                "required": [
                  "id"
                ],
                "title": "FeedbackExample",
                "type": "object"
              }
            },
            "title": "send_feedback_toolArguments",
            "additionalProperties": false
          },
          "name": "send_feedback",
          "outputSchema": {
            "properties": {
              "status": {
                "const": "received",
                "title": "Status",
                "type": "string"
              },
              "feedback_id": {
                "description": "ID of the stored report.",
                "title": "Feedback Id",
                "type": "string"
              },
              "duplicate": {
                "default": false,
                "description": "True when the same report was received in the last 24 hours; feedback_id is the original report and nothing new was stored.",
                "title": "Duplicate",
                "type": "boolean"
              },
              "report": {
                "$ref": "#/$defs/FeedbackReport",
                "description": "Exactly what Parallel received, with secrets removed."
              },
              "next_step": {
                "description": "What the agent should do next.",
                "title": "Next Step",
                "type": "string"
              }
            },
            "required": [
              "status",
              "feedback_id",
              "report",
              "next_step"
            ],
            "type": "object",
            "$defs": {
              "FeedbackReport": {
                "properties": {
                  "message": {
                    "title": "Message",
                    "type": "string"
                  },
                  "category": {
                    "enum": [
                      "results_quality",
                      "error",
                      "latency",
                      "missing_capability",
                      "docs",
                      "billing",
                      "other"
                    ],
                    "title": "Category",
                    "type": "string"
                  },
                  "product": {
                    "enum": [
                      "search",
                      "extract",
                      "task",
                      "findall",
                      "monitor",
                      "responses",
                      "decisions",
                      "mcp",
                      "cli",
                      "other"
                    ],
                    "title": "Product",
                    "type": "string"
                  },
                  "severity": {
                    "enum": [
                      "blocking",
                      "degraded",
                      "minor"
                    ],
                    "title": "Severity",
                    "type": "string"
                  },
                  "examples": {
                    "items": {
                      "$ref": "#/$defs/FeedbackReportExample"
                    },
                    "title": "Examples",
                    "type": "array"
                  },
                  "expected": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Expected"
                  },
                  "actual": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Actual"
                  },
                  "context": {
                    "$ref": "#/$defs/FeedbackReportContext"
                  },
                  "redactions": {
                    "description": "How many secrets were removed.",
                    "title": "Redactions",
                    "type": "integer"
                  },
                  "recipient": {
                    "description": "Who receives the report and how long it is kept.",
                    "title": "Recipient",
                    "type": "string"
                  }
                },
                "required": [
                  "message",
                  "category",
                  "product",
                  "severity",
                  "examples",
                  "context",
                  "redactions",
                  "recipient"
                ],
                "title": "FeedbackReport",
                "type": "object"
              },
              "FeedbackReportContext": {
                "properties": {
                  "org_id": {
                    "title": "Org Id",
                    "type": "string"
                  },
                  "sender": {
                    "description": "Who Parallel sees as the sender.",
                    "title": "Sender",
                    "type": "string"
                  },
                  "surface": {
                    "description": "How the feedback was sent: api, cli, mcp or platform.",
                    "enum": [
                      "api",
                      "cli",
                      "mcp",
                      "platform"
                    ],
                    "title": "Surface",
                    "type": "string"
                  },
                  "user_agent": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
