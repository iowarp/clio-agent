                  },
                  "llm_model": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Llm Model"
                  },
                  "session_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Session Id"
                  }
                },
                "required": [
                  "org_id",
                  "sender",
                  "surface"
                ],
                "title": "FeedbackReportContext",
                "type": "object"
              },
              "FeedbackReportExample": {
                "properties": {
                  "id": {
                    "title": "Id",
                    "type": "string"
                  },
                  "issue": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Issue"
                  },
                  "expected": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Expected"
                  }
                },
                "required": [
                  "id"
                ],
                "title": "FeedbackReportExample",
                "type": "object"
              }
            },
            "title": "FeedbackResponse"
          }
        }
      ]
    }
  }
