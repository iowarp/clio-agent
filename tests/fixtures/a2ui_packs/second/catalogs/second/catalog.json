{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/a2ui/catalogs/second",
  "title": "Second Test Catalog",
  "description": "A second, distinct pack catalog for S8's two-blueprint-isolation tests -- aliases the official Basic Text component under a new name.",
  "catalogId": "https://example.test/a2ui/catalogs/second",
  "components": {
    "SecondText": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "SecondText"
            },
            "text": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            }
          },
          "required": [
            "component",
            "text"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "functions": {},
  "$defs": {
    "CatalogComponentCommon": {
      "type": "object",
      "properties": {}
    }
  }
}
