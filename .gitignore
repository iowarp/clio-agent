# CLIO Agent .gitignore
# Comprehensive ignore patterns for DSPy agent + UV + HPC scientific computing project

# ============================================================================
# Python & Virtual Environments
# ============================================================================

# Virtual environments
venv/
env/
ENV/
.venv

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.whl

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json


# ============================================================================
# MCP & Tool Artifacts
# ============================================================================

# MCP tool outputs
mcp_output/
mcp_logs/
tool_cache/

# Tool-generated files
tool_output/
.clio-agent-artifacts/
.clio/
*.tool.log
mcp_*.log

# ============================================================================
# Development & Testing
# ============================================================================

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
test_output/

# Temporary files
tmp/
/tmp/
temp/
*.tmp
*.bak


# ============================================================================
# Configuration & Secrets
# ============================================================================

# Environment variables with secrets
.env
*.env
.env.local
.env.*.local
*.env.local

# API keys and credentials (CRITICAL - never commit these)
secrets/
.secrets/
credentials.json
api_keys.json
*.key
*.pem
*.pfx

# Configuration that varies per environment
config.local.py
settings.local.json
local_config.yaml

# ============================================================================
# FastAPI/Server Artifacts
# ============================================================================

# FastAPI/Uvicorn
.uvicorn_socket
uvicorn.sock

# Server logs
server_*.log
api_*.log

# ============================================================================
# Build & Packaging
# ============================================================================

# UV lockfile (optional - include if you want reproducible deps)
# uv.lock

# ============================================================================
# OS Specific
# ============================================================================

# macOS
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
.directory

# ============================================================================
# Project Specific - CLIO Agent
# ============================================================================

# AI agents
.planning/
.clio_agent/
.codex

ai-docs/_archived/
ANTHONY/
.research/
docs/ref/

# Agent-run data artifacts left at the repo root (root-scoped: tracked assets
# in subdirectories are unaffected). The real fix is pinning the agent staging
# dir outside the repo (#774); this stops the whack-a-mole meanwhile.
/*.csv
/*.png
/*.geojson
/*.parquet
/*.h5

# Test artefacts (relative-path file_diff tests sometimes leak)
/b.py
/x.py
scratch/

# benchmark run logs & artifacts (evidence, not source)
benchmark/**/runs/*
!benchmark/**/runs/
!benchmark/**/runs/REVIEW_LOG.md
benchmark/**/trace*.jsonl
benchmark/**/report-*.md
/artifacts/

# handshake DB runtime mismatch log
src/clio_agent/providers/handshake/sources/data/model_limits.mismatches.jsonl

# durable live-grind artifacts (server logs + full semantic traces) — kept out of
# /tmp so a run is inspectable/reproducible later, but they are run evidence, not source
.grind/

# Site product screenshots are staged from the gact-tui submodule at Pages deploy
# time (.github/workflows/pages.yml) so they never go stale in git.
site/assets/hero.png
site/assets/desktop-shell.png
site/assets/shots/
