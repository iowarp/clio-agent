FROM node:20-bookworm-slim AS web-builder
ARG PNPM_VERSION=9.15.9
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate
WORKDIR /build
COPY external/gact-tui/apps ./apps
COPY branding ./branding
WORKDIR /build/apps
RUN pnpm install --frozen-lockfile=false --filter "@clio/web..."
RUN GACT_BRAND=clio GACT_BRAND_ROOT=/build/branding pnpm --filter @clio/web build \
    && test -f web/dist/index.html

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    CLIO_GACT_HOST=127.0.0.1 \
    CLIO_GACT_PORT=7777 \
    HOME=/home/clio

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md uv.lock ./
COPY src ./src
RUN pip install --no-cache-dir '.[argonne]'

COPY --from=web-builder /build/apps/web/dist /usr/share/nginx/html
COPY docker/nginx-clio-web.conf /etc/nginx/conf.d/default.conf
COPY docker/clio-web-entrypoint.sh /usr/local/bin/clio-web-entrypoint.sh
RUN rm -f /etc/nginx/sites-enabled/default 2>/dev/null || true \
    && chmod +x /usr/local/bin/clio-web-entrypoint.sh \
    && useradd --create-home --uid 10001 clio

EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=5 \
    CMD curl -fsS "http://127.0.0.1:80/" >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/clio-web-entrypoint.sh"]
