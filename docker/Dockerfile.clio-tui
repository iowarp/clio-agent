FROM golang:1.25-bookworm AS tui-builder
WORKDIR /src
COPY external/gact-tui ./external/gact-tui
COPY scripts/build_clio_tui.sh ./scripts/build_clio_tui.sh
RUN GACT_TUI_ROOT=/src/external/gact-tui ./scripts/build_clio_tui.sh /out/gact

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    CLIO_GACT_HOST=127.0.0.1 \
    CLIO_GACT_PORT=7777 \
    GACT_BRAND=clio \
    HOME=/home/clio \
    TERM=xterm-256color

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md uv.lock ./
COPY src ./src
RUN pip install --no-cache-dir '.[argonne]'

COPY --from=tui-builder /out/gact /usr/local/bin/gact
COPY docker/clio-tui-entrypoint.sh /usr/local/bin/clio-tui-entrypoint.sh
RUN chmod +x /usr/local/bin/gact /usr/local/bin/clio-tui-entrypoint.sh \
    && useradd --create-home --uid 10001 clio

USER clio
WORKDIR /home/clio

ENTRYPOINT ["/usr/local/bin/clio-tui-entrypoint.sh"]
