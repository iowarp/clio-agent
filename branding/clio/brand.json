    "el": {
      "tagline": "\u03b1\u03c0\u03cc \u03c4\u03bf Gnosis Research Center",
      "landing": {
        "eyebrow": "\u03a7\u03ce\u03c1\u03bf\u03c2 \u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1\u03c2 \u03b5\u03c0\u03b9\u03c3\u03c4\u03b7\u03bc\u03bf\u03bd\u03b9\u03ba\u03ae\u03c2 \u03bd\u03bf\u03b7\u03bc\u03bf\u03c3\u03cd\u03bd\u03b7\u03c2",
        "headline": "\u0391\u03c0\u03cc \u03c4\u03bf \u03b5\u03c0\u03b9\u03c3\u03c4\u03b7\u03bc\u03bf\u03bd\u03b9\u03ba\u03cc \u03b5\u03c1\u03ce\u03c4\u03b7\u03bc\u03b1 \u03c3\u03c4\u03bf \u03c4\u03b5\u03ba\u03bc\u03b7\u03c1\u03b9\u03c9\u03bc\u03ad\u03bd\u03bf \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1.",
        "description": "\u03a4\u03bf CLIO \u03c3\u03c5\u03b3\u03ba\u03b5\u03bd\u03c4\u03c1\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03bd\u03b1\u03ba\u03ac\u03bb\u03c5\u03c8\u03b7 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd, \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7, \u03c4\u03bf\u03c5\u03c2 \u03b5\u03be\u03b5\u03b9\u03b4\u03b9\u03ba\u03b5\u03c5\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2 \u03c0\u03c1\u03ac\u03ba\u03c4\u03bf\u03c1\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03ad\u03bb\u03b5\u03c5\u03c3\u03b7 \u03c3\u03b5 \u03ad\u03bd\u03b1\u03bd \u03c7\u03ce\u03c1\u03bf \u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1\u03c2, \u03ce\u03c3\u03c4\u03b5 \u03c4\u03b1 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03ad\u03c3\u03bc\u03b1\u03c4\u03b1 \u03bd\u03b1 \u03bc\u03ad\u03bd\u03bf\u03c5\u03bd \u03b4\u03b9\u03b5\u03c1\u03b5\u03c5\u03bd\u03ae\u03c3\u03b9\u03bc\u03b1, \u03b1\u03bd\u03b1\u03c0\u03b1\u03c1\u03b1\u03b3\u03ce\u03b3\u03b9\u03bc\u03b1 \u03ba\u03b1\u03b9 \u03ad\u03c4\u03bf\u03b9\u03bc\u03b1 \u03b3\u03b9\u03b1 \u03ba\u03bf\u03b9\u03bd\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7."
      },
      "workspace": {
        "greeting": "\u03a4\u03b9 \u03b8\u03b1 \u03b4\u03b9\u03b5\u03c1\u03b5\u03c5\u03bd\u03ae\u03c3\u03bf\u03c5\u03bc\u03b5;"
