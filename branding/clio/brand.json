{
  "name": "CLIO",
  "wordmark": "CLIO",
  "tagline": "by the Gnosis Research Center",
  "taglineAccent": "Gnosis Research Center",
  "homeUrl": "https://iowarp.ai",
  "taglineAccentUrl": "https://grc.iit.edu",
  "landing": {
    "eyebrow": "Scientific intelligence workspace",
    "headline": "From scientific question to defensible result.",
    "description": "CLIO brings data discovery, analysis, expert agents, and provenance into one workspace so results stay explorable, reproducible, and ready to share."
  },
  "workspace": {
    "greeting": "What should we investigate?",
    "description": "Start with a scientific question, continue existing evidence, or choose an example."
  },
  "markGlyph": "C",
  "logoSvg": "logo.svg",
  "logoImage": "mark.svg",
  "accent": "#ea7b2a",
  "themeTokens": {
    "--color-accent": "#ea7b2a"
  },
  "sessionSemantics": {
    "blueprintLabel": "NDP Organization",
    "showExpertPackPicker": false,
    "blueprintDisplayNames": {
      "earthscope-gnss-region": "EarthScope",
      "EarthScope GNSS Region": "EarthScope"
    }
  },
  "backendRepository": {
    "label": "github.com/iowarp/clio-agent",
    "url": "https://github.com/iowarp/clio-agent",
    "detail": "CLIO backend"
  },
  "releaseUrl": "https://github.com/iowarp/clio-agent/releases",
  "desktopReleaseUrl": "https://github.com/iowarp/clio-agent/releases",
  "agentReleaseUrl": "https://github.com/iowarp/clio-agent/releases",
  "backend": {
    "mode": "managed",
    "sidecarName": "clio-agent",
    "portConfig": {
      "key": "gact.port",
      "env": "CLIO_PORT",
      "default": 17800,
      "file": "config.yaml in the clio-agent config root (clio-paths.yaml roots.<os>.config)",
      "scope": "user config.yaml only; a workspace config.yaml cannot set it",
      "precedence": "--port > config gact.port > CLIO_PORT > 17800",
      "resolver": "python -I -m clio_agent.server_port"
    },
    "attachPort": 17800,
    "attachPortEnv": "CLIO_PORT",
    "attachUrlEnv": "CLIO_GACT_URL",
    "install": {
      "ref": "",
      "refEnv": "CLIO_REF",
      "forceEnv": "CLIO_FORCE",
      "windowsUrl": "https://raw.githubusercontent.com/iowarp/clio-agent/main/install/install.ps1",
      "unixUrl": "https://raw.githubusercontent.com/iowarp/clio-agent/main/install/install.sh",
      "repoLabel": "github.com/iowarp/clio-agent"
    }
  },
  "starterPrompts": [
    {
      "eyebrow": "EarthScope",
      "label": "What recent ground motion is EarthScope's GNSS network showing around Los Angeles? Pull a real station time series, plot it, and tell me how much to trust the data."
    },
    {
      "eyebrow": "Data",
      "label": "Inspect the HDF5 or Parquet files in this workspace, check their data quality, and convert one to Parquet with a verified read-back."
    },
    {
      "eyebrow": "Weather",
      "label": "Profile CIMIS Station 80 Fresno hourly weather data and produce a temperature, humidity, and wind summary."
    },
    {
      "eyebrow": "Workspace",
      "label": "Inspect the files in this workspace, identify generated artifacts, and explain what evidence is ready to present."
    }
  ],
  "wordmarkImage": "wordmark.svg",
  "faviconSvg": "mark.svg",
  "locales": {
    "es": {
      "tagline": "del Gnosis Research Center",
      "landing": {
        "eyebrow": "Espacio de trabajo de inteligencia cient\u00edfica",
        "headline": "De la pregunta cient\u00edfica al resultado defendible.",
        "description": "CLIO re\u00fane el descubrimiento de datos, el an\u00e1lisis, los agentes expertos y la procedencia en un solo espacio de trabajo, para que los resultados sigan siendo explorables, reproducibles y listos para compartir."
      },
      "workspace": {
        "greeting": "\u00bfQu\u00e9 investigamos?"
      }
    },
