{
  "variant": [
    "lite",
    "bundled"
  ],
  "target": [
    "x86_64-pc-windows-msvc",
    "aarch64-pc-windows-msvc",
    "aarch64-apple-darwin",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu"
  ],
  "include": [
    {
      "target": "x86_64-pc-windows-msvc",
      "os": "windows-latest",
      "bundle-args": "--bundles msi,nsis"
    },
    {
      "target": "aarch64-pc-windows-msvc",
      "os": "windows-11-arm",
      "bundle-args": "--no-bundle"
    },
    {
      "target": "aarch64-apple-darwin",
      "os": "macos-14",
      "bundle-args": "--bundles app,dmg --target aarch64-apple-darwin"
    },
    {
      "target": "x86_64-apple-darwin",
      "os": "macos-14",
      "bundle-args": "--bundles app,dmg --target x86_64-apple-darwin"
    },
    {
      "target": "x86_64-unknown-linux-gnu",
      "os": "ubuntu-22.04",
      "bundle-args": "--bundles deb,appimage,rpm"
    },
    {
      "target": "x86_64-unknown-linux-gnu",
      "variant": "bundled",
      "bundle-args": "--bundles deb,rpm"
    },
    {
      "target": "aarch64-unknown-linux-gnu",
      "os": "ubuntu-22.04-arm",
      "bundle-args": "--bundles deb,appimage,rpm"
    },
    {
      "target": "aarch64-unknown-linux-gnu",
      "variant": "bundled",
      "bundle-args": "--bundles deb,rpm"
    }
  ],
  "exclude": [
    {
      "variant": "bundled",
      "target": "x86_64-apple-darwin"
    },
    {
      "variant": "bundled",
      "target": "aarch64-pc-windows-msvc"
    }
  ]
}
