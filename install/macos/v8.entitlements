<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for other executables that embed V8
  (playwright/driver/node, codex_cli_bin/bin/codex-code-mode-host).
-->
<plist version="1.0">
<dict>
  <!-- V8 reserves its code range with MAP_JIT; without this it aborts at startup
       with "Failed to reserve virtual memory for CodeRange". -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
