<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the managed Node.js of the document runtime
  (document-wheels/nodejs_wheel_binaries-*.whl!nodejs_wheel/bin/node).
-->
<plist version="1.0">
<dict>
  <!-- V8 reserves its code range with MAP_JIT; without this Node aborts at startup
       with "Failed to reserve virtual memory for CodeRange". -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Loads npm native addons (sharp's libvips binding) installed by pnpm, which
       are not signed by our team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
