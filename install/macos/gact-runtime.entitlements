<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the bundled interpreter
  (Contents/Resources/gact-runtime/python/bin/python3.14). See install/macos-signing.md.
-->
<plist version="1.0">
<dict>
  <!-- Loads PyPI wheels' extension modules from document-runtime and MCP server
       environments under ~/Library/Caches, which are not signed by our team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- ctypes/cffi callbacks allocate writable+executable trampolines. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
