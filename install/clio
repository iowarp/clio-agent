#!/usr/bin/env bash
# CLIO launcher + server lifecycle manager.
#
# `clio` with no arguments boots the clio-agent server (if not already
# up) and opens Web. The TUI is frozen and unsupported. The
# subcommands let you manage the backing
# server process without hunting PIDs.
#
#   clio                      ensure server is up, then open Web
#   clio web | --web [--dev]  ensure server is up, then open the web UI in a browser.
#                             default serves the installed bundle; --dev builds and
#                             serves your working checkout (CLIO_WEB_SRC) instead.
#   clio desktop | --desktop [--dev]  launch the desktop app. default runs the
#                             installed binary (CLIO_DESKTOP_BIN); --dev runs the
#                             Tauri dev shell from your working checkout.
#   clio start           start the headless server
#   clio stop            stop the server
#   clio restart         stop then start
#   clio status | ps     PID / port / health
#   clio logs [N]        tail server logs
#   clio update          update clio-agent to the latest PyPI release (uv pip -U)
#   clio doctor          check prerequisites and install layout
#   clio sandbox status  show the OS write-fence (sandbox) status row
#   clio sandbox setup   provision the OS write fence (one UAC prompt on Windows; idempotent)
#   clio store-check     say whether your data was written by CLIO 0.9.5.1 or older
#   clio reset-store [--yes]  move that data aside, unchanged (never deleted); CLIO starts empty
#   clio report          print a diagnostics bundle for GitHub issues
#   clio completion SH   print shell completion (bash|zsh)
#   clio uninstall [...] run the uninstaller
#   clio help            this text
#
# Global option (any command that starts, stops or talks to the server):
#   --port N             use port N, over gact.port and CLIO_PORT
#
# On launch, clio prints a one-line hint when a newer clio-agent is on PyPI
# (throttled to ~once/day; set CLIO_NO_UPDATE_CHECK=1 to disable).
#
# Environment overrides:
#   CLIO_PREFIX   install root      (default: <agent data>/app: ~/Library/Application
#                 Support/clio-agent/data/app on macOS, ~/.local/share/clio-agent/app
#                 on Linux; ~/.local/share/clio for installs made before 0.9.5)
#   CLIO_PORT     server port when no --port is given and the user config.yaml
#                 sets no gact.port (default: 17800)
#   CLIO_BIN_DIR  launcher location (default: $HOME/.local/bin)
#   CLIO_LOG      server log path   (default: <agent state>/clio-server.<host>.log)
#   CLIO_NO_UPDATE_CHECK  set to 1 to skip the on-launch PyPI update check
#   CLIO_WEB_DIR  built web dist to serve (overrides the installed bundle)
#   CLIO_WEB_SRC  gact-tui checkout for `--dev` builds (auto-detected if unset)
#   CLIO_WEB_NO_BUILD  set to 1 to skip the `--dev` rebuild and serve the last dist
#   CLIO_DESKTOP_BIN   installed desktop app binary for `clio --desktop`
#   CLIO_ACCEPT_UNSANDBOXED  set to 1 to acknowledge running without protected
#                 execution (OS sandbox) instead of confirming at the prompt
set -euo pipefail

if [[ "$(uname -s)" = Darwin* ]]; then
  agent_data_default="$HOME/Library/Application Support/clio-agent/data"
else
  xdg_data="${XDG_DATA_HOME:-}"
  case "$xdg_data" in /*) ;; *) xdg_data="$HOME/.local/share" ;; esac
  agent_data_default="$xdg_data/clio-agent"
fi
agent_data="${CLIO_AGENT_DATA_DIR:-${CLIO_AGENT_HOME:+$CLIO_AGENT_HOME/data}}"
agent_data="${agent_data:-${CLIO_USER_DIR:+$CLIO_USER_DIR/data}}"
agent_data="${agent_data:-$agent_data_default}"
case "$agent_data" in /*) ;; *) echo "Agent data root must be absolute" >&2; exit 2 ;; esac
requested_prefix="${CLIO_PREFIX:-}"
CLIO_PREFIX="${CLIO_PREFIX:-$agent_data/app}"
if [[ -z "$requested_prefix" && -z "${CLIO_AGENT_HOME:-}${CLIO_AGENT_DATA_DIR:-}${CLIO_USER_DIR:-}" && ! -d "$CLIO_PREFIX/clio-agent/.venv" && -d "$HOME/.local/share/clio/clio-agent/.venv" ]]; then
  CLIO_PREFIX="$HOME/.local/share/clio"
fi
CLIO_PORT="${CLIO_PORT:-17800}"
# clio-launcher-feature: port-flag (remote deploys pass --port only when this marker exists)
# `--port N` before or after the command wins over gact.port and CLIO_PORT. Commands that
# hand their arguments to another program keep theirs untouched.
CLIO_EXPLICIT_PORT=""
port_given=0
launcher_args=()
launcher_cmd=""
while (($#)); do
  if [[ -n "$launcher_cmd" ]] && [[ "$launcher_cmd" =~ ^(sandbox|store-check|reset-store|uninstall|logs|completion)$ ]]; then
    launcher_args+=("$@")
    break
  fi
  case "$1" in
    --port)
      [[ $# -ge 2 ]] || { echo "clio: --port needs a value" >&2; exit 2; }
      CLIO_EXPLICIT_PORT="$2" port_given=1
      shift 2
      ;;
    --port=*) CLIO_EXPLICIT_PORT="${1#--port=}" port_given=1; shift ;;
    *)
      [[ -n "$launcher_cmd" ]] || launcher_cmd="$1"
      launcher_args+=("$1")
      shift
      ;;
  esac
done
set -- ${launcher_args[@]+"${launcher_args[@]}"}
if ((port_given)); then
  if ! [[ "$CLIO_EXPLICIT_PORT" =~ ^[0-9]{1,5}$ ]] || ((10#$CLIO_EXPLICIT_PORT < 1 || 10#$CLIO_EXPLICIT_PORT > 65535)); then
    echo "clio: --port must be a TCP port (1-65535), got '$CLIO_EXPLICIT_PORT'" >&2
    exit 2
  fi
  CLIO_PORT="$((10#$CLIO_EXPLICIT_PORT))"
fi
CLIO_BIN_DIR="${CLIO_BIN_DIR:-$HOME/.local/bin}"
# Agent data stays with the selected install. The clio-core daemon does NOT: there
# is exactly one per machine (its state under ~/.clio/hosts/<host>, fixed ports,
# one CTE config per host), shared by every CLIO on that machine, so the
# launcher never scopes its identity.
# Preserve an existing legacy session store until an explicit migration retires it.
if [[ -z "${CLIO_SESSIONS_PATH:-}" && -f "$CLIO_PREFIX/clio-agent/.clio/agent/sessions.json" ]]; then
  export CLIO_SESSIONS_PATH="$CLIO_PREFIX/clio-agent/.clio/agent/sessions.json"
fi
export PATH="$CLIO_BIN_DIR:$PATH"
# The installer provisions supported MCP launchers into CLIO_BIN_DIR. Ensure a
# detached server inherits that directory even when it was started through a
# non-interactive SSH session whose login profile did not extend PATH.
# File access defaults to clio's active workspace + /tmp (the file policy injects
# the workspace root); set CLIO_ALLOWED_ROOTS only to deliberately widen that.
# The install prefix is often on a home directory shared by every node of a
# cluster (login and compute nodes mount the same NFS home). A server and its
# pid belong to one host, so the launcher's per-server files are keyed by it:
# a login node's pidfile must never describe a compute node's server.
CLIO_HOST_ID="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo localhost)"
CLIO_STATE="$CLIO_PREFIX"
CLIO_CACHE="$CLIO_PREFIX"
if [[ -x "$CLIO_PREFIX/clio-agent/.venv/bin/python" ]]; then
  # One interpreter start for the Agent's state and cache roots and the configured
  # server port (gact.port in the user config.yaml, else CLIO_PORT, else 17800). An
  # install from before gact.port existed answers with an empty port line. -I and a
  # neutral cwd keep a checkout's files and PYTHON* variables out of the answer.
  installed_settings="$(cd / && "$CLIO_PREFIX/clio-agent/.venv/bin/python" -I -c '
import sys
from clio_agent.paths import user_cache_dir, user_state_dir
print(user_state_dir())
print(user_cache_dir())
try:
    from clio_agent.server_port import configured_port
    print(configured_port())
except ImportError:
    print("")
except ValueError as exc:
    print(f"!! {exc}; using CLIO_PORT or 17800", file=sys.stderr)
    print("")
')"
  configured_port=""
  { IFS= read -r CLIO_STATE; IFS= read -r CLIO_CACHE; IFS= read -r configured_port; } <<<"$installed_settings" || true
  CLIO_CACHE="${CLIO_CACHE:-$CLIO_STATE}"
  if [[ -n "$configured_port" ]] && ((!port_given)); then CLIO_PORT="$configured_port"; fi
  mkdir -p "$CLIO_STATE" "$CLIO_CACHE"
fi
PIDFILE="$CLIO_STATE/clio-server.$CLIO_HOST_ID.pid"
SERVER_LOG="${CLIO_LOG:-$CLIO_STATE/clio-server.$CLIO_HOST_ID.log}"
# Loopback is this host: never send it to a site proxy. Cluster nodes often
# export http_proxy for the whole environment, and a proxied check of
# http://127.0.0.1:PORT is answered by the proxy (a compute node's squid
# replied 503) for a server that is not running here.
export no_proxy="127.0.0.1,localhost,::1${no_proxy:+,$no_proxy}"
export NO_PROXY="127.0.0.1,localhost,::1${NO_PROXY:+,$NO_PROXY}"
GACT_LOG="$CLIO_STATE/gact-stderr.log"
SERVER_BIN="$CLIO_PREFIX/clio-agent/.venv/bin/clio-agent"
WEB_DIR="$CLIO_PREFIX/clio-agent/web"
CLIO_VENV="$CLIO_PREFIX/clio-agent/.venv"
UPDATE_STAMP="$CLIO_CACHE/.update-checked"

GREEN='\033[0;32m'; YELLOW='\033[0;33m'; RED='\033[0;31m'; RESET='\033[0m'
say()  { printf "${GREEN}==>${RESET} %s\n" "$*"; }
warn() { printf "${YELLOW}!!${RESET} %s\n" "$*" >&2; }
err()  { printf "${RED}xx${RESET} %s\n" "$*" >&2; }

# health returns 0 when the server answers /v1/health on the port.
# CLIO answers within a second of binding, even while clio-core is still
# attaching (503 while a required dependency is not up yet). Treat 503 as
# "server is up" so the TUI can surface and resolve the dependency state.
health() {
  local code
  code="$(curl --noproxy '*' -sS -m 1 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$CLIO_PORT/v1/health" 2>/dev/null || true)"
  [[ "$code" = "200" || "$code" = "503" ]]
}

# serving_web returns 0 when the running server is serving the web SPA at "/".
serving_web() {
  curl --noproxy '*' -sS -m 1 "http://127.0.0.1:$CLIO_PORT/" 2>/dev/null | grep -qiE "<html|<!doctype html"
}

# file_mtime echoes a file's modification time in epoch seconds, or 0.
# GNU stat spells it `-c %Y`; BSD/macOS stat spells it `-f %m`.
file_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
}

# update_check prints a one-line hint when the installed clio-agent is behind
# the latest PyPI release. Best-effort: throttled to ~once/day via a stamp file,
# bounded by a short curl timeout, and silent on any failure (offline, no venv).
# Set CLIO_NO_UPDATE_CHECK=1 to disable. Synchronous + fast so it never corrupts
# the TUI display, but a no-op on all but ~one launch per day.
update_check() {
  [[ "${CLIO_NO_UPDATE_CHECK:-0}" = "1" ]] && return 0
  if [[ -f "$UPDATE_STAMP" ]]; then
    local age=$(( $(date +%s) - $(file_mtime "$UPDATE_STAMP") ))
    [[ "$age" -lt 86400 ]] && return 0
  fi
  local installed latest behind
  installed="$("$CLIO_VENV/bin/python" -c 'import importlib.metadata as m; print(m.version("clio-agent"))' 2>/dev/null)" || return 0
  latest="$(curl -sS -m 4 https://pypi.org/pypi/clio-agent/json 2>/dev/null \
    | "$CLIO_VENV/bin/python" -c 'import sys,json; print(json.load(sys.stdin)["info"]["version"])' 2>/dev/null)" || return 0
  [[ -z "$installed" || -z "$latest" ]] && return 0
  touch "$UPDATE_STAMP" 2>/dev/null || true
  # Python version ordering (a beta sorts before its final release; `sort -V`
  # does not know that). An install newer than the latest stable is not behind.
  behind="$("$CLIO_VENV/bin/python" -c 'import sys; from packaging.version import Version as V; print(int(V(sys.argv[1]) < V(sys.argv[2])))' "$installed" "$latest" 2>/dev/null)" || return 0
  if [[ "$behind" = 1 ]]; then
    warn "clio-agent update available: $installed -> $latest  (run: clio update)"
  fi
}

# drop_stale_document_wheels: a release's prebuilt runtime (runtime.json) carries
# document wheels built for that release's document lock. Once `clio update` has
# replaced clio-agent with one that locks other packages, they no longer apply and
# preparing documents would reject them; dropping them prepares from the new lock.
drop_stale_document_wheels() {
  local wheels="$CLIO_VENV/document-wheels"
  [[ -f "$CLIO_VENV/runtime.json" && -f "$wheels/manifest.json" ]] || return 0
  "$CLIO_VENV/bin/python" -I -B - "$wheels/manifest.json" <<'PY' && return 0
import hashlib, importlib.util, json, sys
from pathlib import Path
spec = importlib.util.find_spec("clio_agent")
lock = Path(spec.origin).parent / "runtime/document_stack/uv.lock"
manifest = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
sys.exit(manifest.get("lock_sha256") != hashlib.sha256(lock.read_bytes()).hexdigest())
PY
  rm -rf "$wheels"
  say "the release's bundled document packages no longer match; they will download on first use"
}

# open_url launches the default browser cross-platform (best-effort, backgrounded).
open_url() {
  local url="$1"
  if command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then open "$url" >/dev/null 2>&1 &
  elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url" >/dev/null 2>&1 &
  else warn "open $url in your browser"; fi
}

# resolve_web_src echoes the gact-tui checkout used by `--dev` builds,
# honoring $CLIO_WEB_SRC first, then a few common locations. Echoes nothing and
# returns 1 when none is found (the caller prints actionable guidance).
resolve_web_src() {
  local cand
  if [[ -n "${CLIO_WEB_SRC:-}" && -f "$CLIO_WEB_SRC/web/package.json" ]]; then
    printf '%s\n' "$CLIO_WEB_SRC"; return 0
  fi
  for cand in "$HOME/gact-tui" "$HOME/clio/gact-tui" \
              "$HOME/src/gact-tui" "$HOME/projects/gact-tui"; do
    [[ -f "$cand/web/package.json" ]] && { printf '%s\n' "$cand"; return 0; }
  done
  return 1
}

# server_pid echoes a live server PID (from the pidfile, validated) or
# returns 1. Falls back to a port-owner lookup so a server started
# outside this launcher is still manageable.
# running PID: the process exists and has not exited. One that exited but was not yet
# reaped (its parent is a container's PID 1 without an init, which never reaps) is a
# zombie: `kill -0` still succeeds on it, so its state is read too.
running() {
  local state=""
  kill -0 "$1" 2>/dev/null || return 1
  if [[ -r "/proc/$1/stat" ]]; then
    state="$(sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f1)"
  else
    state="$(ps -o stat= -p "$1" 2>/dev/null | cut -c1)"
  fi
  [[ "$state" != Z ]]
}

server_pid() {
  local p=""
  if command -v lsof >/dev/null 2>&1; then
    p="$(lsof -ti "tcp:$CLIO_PORT" -sTCP:LISTEN 2>/dev/null | head -n1 || true)"
    if [[ -n "$p" ]]; then echo "$p"; return 0; fi
  fi
  if [[ -f "$PIDFILE" ]]; then
    p="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [[ -n "$p" ]] && running "$p"; then
      echo "$p"; return 0
    fi
  fi
  return 1
}

# Set to 1 by start_server when it actually launches a server (vs finding one
# already healthy). The attach flow reads it to decide whether closing the TUI
# should also stop the server it just started.
SERVER_WAS_STARTED=0

start_server() {
  SERVER_WAS_STARTED=0
  if health; then
    say "CLIO server already running on :$CLIO_PORT"
    return 0
  fi
  # A pidfile with no healthy server is a stale/zombie launch - drop it.
  rm -f "$PIDFILE"
  if [[ ! -x "$SERVER_BIN" ]]; then
    err "server binary not found: $SERVER_BIN"
    err "is CLIO installed? run the installer or set CLIO_PREFIX."
    return 1
  fi
  say "Starting CLIO server on :$CLIO_PORT (log: $SERVER_LOG)"
  # The server runs as its own session/process-group leader (PGID == PID)
  # so stop_server can group-kill the server AND every MCP child it spawns (the
  # uvx stdio servers) instead of orphaning them. It also detaches from the
  # controlling terminal (replaces nohup); stdin from /dev/null so the daemon
  # never blocks on a read. macOS ships no setsid(1), so the install's own
  # Python calls setsid(2) and then execs the server under the same PID.
  local detach=()
  if command -v setsid >/dev/null 2>&1; then
    detach=(setsid)
  elif [[ -x "$CLIO_VENV/bin/python" ]]; then
    # setsid(2) fails only when the caller already leads a process group, which
    # satisfies the group-kill contract as well.
    detach=("$CLIO_VENV/bin/python" -I -B -c \
      'import os, sys
try:
    os.setsid()
except OSError:
    pass
os.execv(sys.argv[1], sys.argv[1:])')
  fi
  (
    cd "$CLIO_PREFIX/clio-agent" &&
    api_port="$CLIO_PORT" &&
    # Installed user tools such as clio-kit normally live beside this
    # launcher. Login shells add that directory, but detached GUI/SSH starts
    # often do not; make the managed server see the same tools explicitly.
    export PATH="$CLIO_BIN_DIR:$PATH" &&
    # CLIO_PORT belongs to this launcher/API. clio-core also recognizes that
    # generic name for its native RPC listener, so leaking it would make the
    # runtime steal the HTTP API port. The agent already receives --port.
    unset CLIO_PORT &&
    exec ${detach[@]+"${detach[@]}"} "$SERVER_BIN" serve --port "$api_port" >"$SERVER_LOG" 2>&1 </dev/null
  ) &
  echo $! >"$PIDFILE"
  SERVER_WAS_STARTED=1
  # First-run startup is slow (ARC/LSM init + MCP server spawn) and can take
  # 30-60s; only fail after a generous window so a healthy-but-slow start isn't
  # reported as a failure (the server keeps coming up in the background anyway).
  local i
  for i in $(seq 1 180); do
    if health; then say "  healthy (pid $(cat "$PIDFILE" 2>/dev/null || echo '?'))"; return 0; fi
    sleep 0.5
  done
  err "server did not become healthy in ~90s - check $SERVER_LOG"
  return 1
}

stop_server() {
  local p
  p="$(server_pid || true)"
  if [[ -z "$p" ]]; then
    say "no CLIO server running"
    rm -f "$PIDFILE"
    return 0
  fi
  say "Stopping CLIO server (pid $p) and its MCP children"
  # Group-kill: the server leads its own process group (started via setsid), so its
  # MCP subprocess children (uvx stdio servers) share the group. Signal the whole
  # group (negative PID) so none are orphaned. Fall back to a plain PID kill for a
  # server started outside this launcher (not a group leader).
  kill -TERM -"$p" 2>/dev/null || kill -TERM "$p" 2>/dev/null || true
  # A running turn is cancelled and drained before the agent releases its
  # shared clio-core client.  Five seconds was shorter than that normal path:
  # the launcher could SIGKILL Python while it was still in lifespan teardown,
  # orphaning clio-core.  Match the desktop supervisor's 30-second graceful
  # budget; the loop still returns immediately as soon as the server exits.
  local i
  for i in $(seq 1 120); do
    running "$p" || break
    sleep 0.25
  done
  if running "$p"; then
    warn "  did not exit - force killing the process group"
    kill -9 -"$p" 2>/dev/null || kill -9 "$p" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
  say "  stopped"
}

# sandbox_ack warns when the running server's agent tools have no OS write fence.
# CLIO stays usable without one (fail-open), so the user must acknowledge the risk:
# an interactive terminal must confirm, while other runs only warn. Set
# CLIO_ACCEPT_UNSANDBOXED=1 to acknowledge without the prompt. Declining stops a
# server this invocation started and returns 1.
sandbox_ack() {
  local py="$CLIO_VENV/bin/python" body verdict state="" reason="" warning="" next=""
  [[ -x "$py" ]] || return 0
  # The verdict exists once boot resolves the backend, a few seconds after /v1/health answers.
  for _ in $(seq 1 120); do
    body="$(curl --noproxy '*' -sS -m 2 "http://127.0.0.1:$CLIO_PORT/v1/system/sandbox" 2>/dev/null || true)"
    verdict="$(printf '%s' "$body" | "$py" -I -B -c '
import json, sys
try:
    row = json.loads(sys.stdin.read() or "null")
except ValueError:
    row = None
if not isinstance(row, dict) or row.get("name") != "sandbox":
    print("retry")
    sys.exit()
if "acknowledgement_required" in row:
    resolved, required = row.get("resolved", True), row["acknowledgement_required"]
else:  # a server from before the acknowledgement fields
    resolved, required = True, row.get("status") != "ready"
if not resolved:
    print("retry")
    sys.exit()
print("warn" if required else "ok")
for value in (row.get("reason"), row.get("warning") or row.get("summary"), row.get("next_action")):
    print(" ".join(str(value or "").split()))
' 2>/dev/null || echo retry)"
    { IFS= read -r state; IFS= read -r reason; IFS= read -r warning; IFS= read -r next; } <<<"$verdict" || true
    [[ "$state" == retry ]] || break
    sleep 0.5
  done
  case "$state" in
    ok) return 0 ;;
    warn) ;;
    *)
      warn "could not read the sandbox (protected execution) state from the server; run 'clio sandbox status'"
      return 0
      ;;
  esac
  printf "${RED}%s${RESET}\n" \
    "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" \
    "!!  SECURITY WARNING: protected execution (OS sandbox) is OFF" \
    "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >&2
  printf "  %s\n" "$warning" >&2
  [[ -n "$reason" ]] && printf "  reason: %s\n" "$reason" >&2
  [[ -n "$next" ]] && printf "  next:   %s\n" "$next" >&2
  if [[ "${CLIO_ACCEPT_UNSANDBOXED:-0}" == 1 ]]; then
    warn "acknowledged by CLIO_ACCEPT_UNSANDBOXED=1"
    return 0
  fi
  if [[ ! -t 0 ]]; then
    warn "not an interactive terminal: continuing without protected execution"
    return 0
  fi
  local answer=""
  printf "Continue without protected execution? [y/N] " >&2
  IFS= read -r answer || answer=""
  case "$answer" in
    y|Y|yes|YES|Yes) return 0 ;;
  esac
  err "not acknowledged"
  if (( SERVER_WAS_STARTED )); then stop_server; fi
  return 1
}

status_server() {
  local p health_txt
  p="$(server_pid || true)"
  if health; then health_txt="healthy"; else health_txt="not responding"; fi
  echo "prefix:  $CLIO_PREFIX"
  echo "port:    $CLIO_PORT"
  if [[ -n "$p" ]]; then echo "pid:     $p"; else echo "pid:     (none)"; fi
  echo "health:  $health_txt"
  echo "server:  $SERVER_LOG"
  echo "gact:    $GACT_LOG"
}

show_logs() {
  local n="${1:-40}"
  local files=()
  [[ -f "$SERVER_LOG" ]] && files+=("$SERVER_LOG")
  [[ -f "$GACT_LOG" ]] && files+=("$GACT_LOG")
  if [[ ${#files[@]} -eq 0 ]]; then
    warn "no logs yet (server hasn't run, or different CLIO_PREFIX)"
    return 0
  fi
  tail -n "$n" -F "${files[@]}"
}

doctor() {
  local ok=0
  echo "CLIO doctor"
  echo "  prefix:       $CLIO_PREFIX"
  printf "  server bin:   "; if [[ -x "$SERVER_BIN" ]]; then echo "ok"; else echo "MISSING"; ok=1; fi
  echo "  frontend:     Web / Desktop (legacy TUI frozen and unsupported)"
  printf "  curl:         "; if command -v curl >/dev/null 2>&1; then echo "ok"; else echo "MISSING"; ok=1; fi
  printf "  port :%s:  " "$CLIO_PORT"; if health; then echo "server healthy"; else echo "free / no server"; fi
  printf "  launcher:     "; if [[ -e "$CLIO_BIN_DIR/clio" ]]; then echo "$CLIO_BIN_DIR/clio"; else echo "not in $CLIO_BIN_DIR"; fi
  return $ok
}

# report prints a diagnostics bundle suitable for pasting into a GitHub
# issue: versions, environment, health, and the tail of every log.
report() {
  echo "==== CLIO bug report ===="
  echo "date:       $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "os:         $(uname -srm)"
  echo "prefix:     $CLIO_PREFIX"
  echo "port:       $CLIO_PORT"
  echo "frontend:   Web / Desktop; legacy TUI frozen and unsupported"
  if [[ -f "$CLIO_PREFIX/clio-agent/pyproject.toml" ]]; then
    echo "clio-agent: $(grep -m1 '^version' "$CLIO_PREFIX/clio-agent/pyproject.toml" 2>/dev/null || true)"
  fi
  if health; then echo "health:     healthy"; else echo "health:     not responding"; fi
  local lf
  for lf in "$SERVER_LOG" "$GACT_LOG"; do
    echo ""
    echo "---- $lf (last 40 lines) ----"
    if [[ -f "$lf" ]]; then tail -n 40 "$lf"; else echo "(none)"; fi
  done
  echo ""
  echo "==== end report ===="
}

completion() {
  local cmds="web start stop restart status ps logs sandbox store-check reset-store doctor report completion uninstall help"
  case "${1:-}" in
    bash)
      cat <<EOF
_clio() {
  COMPREPLY=( \$(compgen -W "$cmds" -- "\${COMP_WORDS[COMP_CWORD]}") )
}
complete -F _clio clio
EOF
      ;;
    zsh)
      cat <<EOF
#compdef clio
_clio() {
  local -a cmds
  cmds=($cmds)
  _describe 'command' cmds
}
# Autoloaded from fpath it completes; sourced from ~/.zshrc it registers.
if [ "\$funcstack[1]" = "_clio" ]; then _clio "\$@"; else compdef _clio clio; fi
EOF
      ;;
    *)
      err "usage: clio completion bash|zsh"
      return 2
      ;;
  esac
}

# usage prints the leading comment block as help text - reads until the
# first non-comment line so it stays correct as the header grows.
usage() {
  awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    attach|tui|--tui)
      err "The TUI is frozen and unsupported in CLIO 0.9.5.1. Use CLIO Desktop or clio web."
      return 2
      ;;
    ""|web|--web)
      shift || true
      update_check
      local web_dev=0 arg
      for arg in "$@"; do [[ "$arg" == "--dev" ]] && web_dev=1; done
      if (( web_dev )); then
        # --dev: build + serve the web app from your working checkout instead of
        # the installed bundle, so `clio --web --dev` shows what you're building.
        local src
        if ! src="$(resolve_web_src)"; then
          err "clio --web --dev: set CLIO_WEB_SRC to your gact-tui checkout (none auto-detected)"
          return 1
        fi
        command -v pnpm >/dev/null 2>&1 || { err "clio --web --dev needs pnpm on PATH to build the web"; return 1; }
        if [[ "${CLIO_WEB_NO_BUILD:-0}" != 1 ]]; then
          say "building dev web bundle from $src (set CLIO_WEB_NO_BUILD=1 to skip)"
          ( cd "$src" && pnpm --filter @clio/workspace build ) || { err "dev web build failed"; return 1; }
        fi
        export CLIO_WEB_DIR="$src/web/dist"
        [[ -f "$CLIO_WEB_DIR/index.html" ]] || { err "no built web at $CLIO_WEB_DIR (run without CLIO_WEB_NO_BUILD)"; return 1; }
        say "serving DEV web bundle from $CLIO_WEB_DIR"
      fi
      if [[ ! -f "$WEB_DIR/index.html" && -z "${CLIO_WEB_DIR:-}" ]]; then
        err "web bundle not found at $WEB_DIR"
        err "reinstall CLIO with the web bundle, or set CLIO_WEB_DIR to a built web dist"
        return 1
      fi
      export CLIO_WEB_DIR="${CLIO_WEB_DIR:-$WEB_DIR}"
      # The web mount is wired at server startup, so a server already running
      # WITHOUT the web bundle (or serving a DIFFERENT bundle, e.g. switching to
      # --dev) must be restarted to pick up this CLIO_WEB_DIR.
      if health && { ! serving_web || (( web_dev )); }; then
        say "restarting server in web mode"
        stop_server
      fi
      start_server
      sandbox_ack || return 1
      url="http://127.0.0.1:$CLIO_PORT/"
      say "CLIO web UI: $url"
      open_url "$url"
      ;;
    desktop|--desktop)
      shift || true
      local dt_dev=0 arg
      for arg in "$@"; do [[ "$arg" == "--dev" ]] && dt_dev=1; done
      start_server
      if (( dt_dev )); then
        local src
        if ! src="$(resolve_web_src)"; then
          err "clio --desktop --dev: set CLIO_WEB_SRC to your gact-tui checkout (none auto-detected)"
          return 1
        fi
        command -v pnpm >/dev/null 2>&1 || { err "clio --desktop --dev needs pnpm on PATH"; return 1; }
        say "launching desktop dev shell (tauri dev) from $src against :$CLIO_PORT"
        exec env GACT_BACKEND="http://127.0.0.1:$CLIO_PORT" \
          sh -c "cd '$src' && pnpm --filter @clio/desktop tauri:dev"
      fi
      local dt_bin="${CLIO_DESKTOP_BIN:-}"
      if [[ -z "$dt_bin" || ! -x "$dt_bin" ]]; then
        err "clio --desktop: no installed desktop app found"
        err "set CLIO_DESKTOP_BIN to the built binary, or use 'clio --desktop --dev' for the Tauri dev shell"
        return 1
      fi
      say "launching desktop app: $dt_bin"
      exec "$dt_bin"
      ;;
    start)        update_check; start_server && sandbox_ack ;;
    stop)         stop_server ;;
    restart)
      # Restart keeps what the server served: one started by `clio web` (or bare `clio`)
      # comes back serving Web, not as a headless API whose "/" answers 404.
      if serving_web && [[ -z "${CLIO_WEB_DIR:-}" && -f "$WEB_DIR/index.html" ]]; then
        export CLIO_WEB_DIR="$WEB_DIR"
      fi
      stop_server; start_server && sandbox_ack ;;
    update)
      shift || true
      local uv_bin
      local wheel_arg=""
      [[ "$(uname -s)" != Darwin ]] || wheel_arg="--only-binary=rasterio"
      uv_bin="$(command -v uv 2>/dev/null || true)"
      [[ -z "$uv_bin" && -x "$CLIO_VENV/bin/uv" ]] && uv_bin="$CLIO_VENV/bin/uv"
      say "updating clio-agent to the latest PyPI release"
      if health; then say "stopping the running server first"; stop_server; fi
      if [[ -n "$uv_bin" ]]; then
        "$uv_bin" pip install --python "$CLIO_VENV/bin/python" ${wheel_arg:+"$wheel_arg"} -U clio-agent \
          "dspy==3.4.0" "fastmcp==4.1.2" "fastmcp-slim==4.1.2" \
          "fastmcp-tasks==4.1.2" \
          || { err "update failed"; return 1; }
      else
        "$CLIO_VENV/bin/python" -m pip install ${wheel_arg:+"$wheel_arg"} -U clio-agent || { err "update failed (no uv; pip fallback also failed)"; return 1; }
      fi
      drop_stale_document_wheels
      rm -f "$UPDATE_STAMP" 2>/dev/null || true
      say "updated — run 'clio' to start the new version"
      ;;
    status|ps)    status_server ;;
    logs)         shift || true; show_logs "${1:-40}" ;;
    sandbox)
      # Passthrough to the installed clio-agent CLI's `sandbox` verb (setup/status). The OS
      # write-fence provisioning is a first-class launcher command on every install channel.
      shift || true
      [[ -x "$SERVER_BIN" ]] || { err "server binary not found: $SERVER_BIN"; return 1; }
      exec "$SERVER_BIN" sandbox "$@"
      ;;
    store-check|reset-store)
      # Passthrough to the installed clio-agent CLI: data an older CLIO wrote, found and
      # moved aside (it refuses while CLIO runs; `clio stop` first).
      shift || true
      [[ -x "$SERVER_BIN" ]] || { err "server binary not found: $SERVER_BIN"; return 1; }
      exec "$SERVER_BIN" "$cmd" "$@"
      ;;
    doctor)       doctor ;;
    report)       report ;;
    completion)   shift || true; completion "${1:-}" ;;
    uninstall)
      shift || true
      local un="$CLIO_PREFIX/uninstall.sh"
      [[ -x "$un" ]] || un="$CLIO_PREFIX/clio-agent/install/uninstall.sh"
      if [[ -x "$un" ]]; then exec "$un" "$@"; fi
      err "uninstaller not found (looked in $CLIO_PREFIX and the clio-agent checkout)"
      return 1
      ;;
    help|-h|--help) usage ;;
    *)
      err "unknown command: $cmd"
      usage
      return 2
      ;;
  esac
}

main "$@"
