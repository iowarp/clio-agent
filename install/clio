#!/usr/bin/env bash
# CLIO launcher + server lifecycle manager.
#
# `clio` with no arguments boots the clio-agent server (if not already
# up) and attaches the gact TUI - the original one-command UX. The
# subcommands mirror `gact agent *`: they let you manage the backing
# server process without hunting PIDs.
#
#   clio                      ensure server is up, then attach the TUI
#   clio web | --web [--dev]  ensure server is up, then open the web UI in a browser.
#                             default serves the installed bundle; --dev builds and
#                             serves your working checkout (CLIO_WEB_SRC) instead.
#   clio desktop | --desktop [--dev]  launch the desktop app. default runs the
#                             installed binary (CLIO_DESKTOP_BIN); --dev runs the
#                             Tauri dev shell from your working checkout.
#   clio start           start the server (no TUI)
#   clio stop            stop the server
#   clio restart         stop then start
#   clio status | ps     PID / port / health
#   clio logs [N]        tail the server + gact stderr logs
#   clio update          update clio-agent to the latest PyPI release (uv pip -U)
#   clio doctor          check prerequisites and install layout
#   clio report          print a diagnostics bundle for GitHub issues
#   clio completion SH   print shell completion (bash|zsh)
#   clio uninstall [...] run the uninstaller
#   clio help            this text
#
# On launch, clio prints a one-line hint when a newer clio-agent is on PyPI
# (throttled to ~once/day; set CLIO_NO_UPDATE_CHECK=1 to disable).
#
# Environment overrides:
#   CLIO_PREFIX   install root      (default: $HOME/.local/share/clio)
#   CLIO_PORT     server port       (default: 17800)
#   CLIO_BIN_DIR  launcher location (default: $HOME/.local/bin)
#   CLIO_LOG      server log path   (default: $CLIO_PREFIX/clio-server.log)
#   CLIO_NO_UPDATE_CHECK  set to 1 to skip the on-launch PyPI update check
#   CLIO_WEB_DIR  built web dist to serve (overrides the installed bundle)
#   CLIO_WEB_SRC  gact-tui/apps checkout for `--dev` builds (auto-detected if unset)
#   CLIO_WEB_NO_BUILD  set to 1 to skip the `--dev` rebuild and serve the last dist
#   CLIO_DESKTOP_BIN   installed desktop app binary for `clio --desktop`
set -euo pipefail

CLIO_PREFIX="${CLIO_PREFIX:-$HOME/.local/share/clio}"
CLIO_PORT="${CLIO_PORT:-17800}"
CLIO_BIN_DIR="${CLIO_BIN_DIR:-$HOME/.local/bin}"
# clio-agent is tool-source agnostic: marketplace packs declare their own MCP
# servers (e.g. `uvx clio-kit@<ver> mcp-server <name>`), which uvx fetches/caches
# on demand — so the launcher sets NO CLIO_KIT_PATH and has no clio-kit coupling.
# File access defaults to clio's active workspace + /tmp (the file policy injects
# the workspace root); set CLIO_ALLOWED_ROOTS only to deliberately widen that.
PIDFILE="$CLIO_PREFIX/clio-server.pid"
SERVER_LOG="${CLIO_LOG:-$CLIO_PREFIX/clio-server.log}"
GACT_LOG="$CLIO_PREFIX/gact-stderr.log"
SERVER_BIN="$CLIO_PREFIX/clio-agent/.venv/bin/clio-agent-gact"
GACT_BIN="$CLIO_PREFIX/gact"
# The Go TUI is brand-neutral and white-labels purely from GACT_BRAND_NAME at
# runtime (it no longer reads a brand root / brand.json — web+desktop read that
# at build time via apps/brand.config.local.json). This drives the splash
# wordmark + OS window title; override by exporting GACT_BRAND_NAME yourself.
CLIO_BRAND_NAME="${GACT_BRAND_NAME:-CLIO}"
WEB_DIR="$CLIO_PREFIX/clio-agent/web"
CLIO_VENV="$CLIO_PREFIX/clio-agent/.venv"
UPDATE_STAMP="$CLIO_PREFIX/.update-checked"

GREEN='\033[0;32m'; YELLOW='\033[0;33m'; RED='\033[0;31m'; RESET='\033[0m'
say()  { printf "${GREEN}==>${RESET} %s\n" "$*"; }
warn() { printf "${YELLOW}!!${RESET} %s\n" "$*" >&2; }
err()  { printf "${RED}xx${RESET} %s\n" "$*" >&2; }

# health returns 0 when the server answers /v1/health on the port.
# CLIO returns 503 for a reachable server whose dependencies still need
# user configuration, such as first-run LM provider selection. Treat that
# as "server is up" so the TUI can surface and resolve the configuration.
health() {
  local code
  code="$(curl -sS -m 1 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$CLIO_PORT/v1/health" 2>/dev/null || true)"
  [[ "$code" = "200" || "$code" = "503" ]]
}

# serving_web returns 0 when the running server is serving the web SPA at "/".
serving_web() {
  curl -sS -m 1 "http://127.0.0.1:$CLIO_PORT/" 2>/dev/null | grep -qiE "<html|<!doctype html"
}

# update_check prints a one-line hint when the installed clio-agent is behind
# the latest PyPI release. Best-effort: throttled to ~once/day via a stamp file,
# bounded by a short curl timeout, and silent on any failure (offline, no venv).
# Set CLIO_NO_UPDATE_CHECK=1 to disable. Synchronous + fast so it never corrupts
# the TUI display, but a no-op on all but ~one launch per day.
update_check() {
  [[ "${CLIO_NO_UPDATE_CHECK:-0}" = "1" ]] && return 0
  if [[ -f "$UPDATE_STAMP" ]]; then
    local age=$(( $(date +%s) - $(stat -c %Y "$UPDATE_STAMP" 2>/dev/null || echo 0) ))
    [[ "$age" -lt 86400 ]] && return 0
  fi
  local installed latest first
  installed="$("$CLIO_VENV/bin/python" -c 'import importlib.metadata as m; print(m.version("clio-agent"))' 2>/dev/null)" || return 0
  latest="$(curl -sS -m 4 https://pypi.org/pypi/clio-agent/json 2>/dev/null \
    | "$CLIO_VENV/bin/python" -c 'import sys,json; print(json.load(sys.stdin)["info"]["version"])' 2>/dev/null)" || return 0
  [[ -z "$installed" || -z "$latest" ]] && return 0
  touch "$UPDATE_STAMP" 2>/dev/null || true
  if [[ "$installed" != "$latest" ]]; then
    # "behind" when installed sorts before latest under version ordering.
    first="$(printf '%s\n%s\n' "$installed" "$latest" | sort -V | head -1)"
    [[ "$first" = "$installed" ]] && warn "clio-agent update available: $installed -> $latest  (run: clio update)"
  fi
}

# open_url launches the default browser cross-platform (best-effort, backgrounded).
open_url() {
  local url="$1"
  if command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then open "$url" >/dev/null 2>&1 &
  elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url" >/dev/null 2>&1 &
  else warn "open $url in your browser"; fi
}

# resolve_web_src echoes the gact-tui/apps checkout used by `--dev` builds,
# honoring $CLIO_WEB_SRC first, then a few common locations. Echoes nothing and
# returns 1 when none is found (the caller prints actionable guidance).
resolve_web_src() {
  local cand
  if [[ -n "${CLIO_WEB_SRC:-}" && -f "$CLIO_WEB_SRC/web/package.json" ]]; then
    printf '%s\n' "$CLIO_WEB_SRC"; return 0
  fi
  for cand in "$HOME/gact-tui/apps" "$HOME/clio/apps" \
              "$HOME/src/gact-tui/apps" "$HOME/projects/gact-tui/apps"; do
    [[ -f "$cand/web/package.json" ]] && { printf '%s\n' "$cand"; return 0; }
  done
  return 1
}

# server_pid echoes a live server PID (from the pidfile, validated) or
# returns 1. Falls back to a port-owner lookup so a server started
# outside this launcher is still manageable.
server_pid() {
  local p=""
  if command -v lsof >/dev/null 2>&1; then
    p="$(lsof -ti "tcp:$CLIO_PORT" -sTCP:LISTEN 2>/dev/null | head -n1 || true)"
    if [[ -n "$p" ]]; then echo "$p"; return 0; fi
  fi
  if [[ -f "$PIDFILE" ]]; then
    p="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null; then
      echo "$p"; return 0
    fi
  fi
  return 1
}

# Set to 1 by start_server when it actually launches a server (vs finding one
# already healthy). The attach flow reads it to decide whether closing the TUI
# should also stop the server it just started.
SERVER_WAS_STARTED=0

start_server() {
  SERVER_WAS_STARTED=0
  if health; then
    say "CLIO server already running on :$CLIO_PORT"
    return 0
  fi
  # A pidfile with no healthy server is a stale/zombie launch - drop it.
  rm -f "$PIDFILE"
  if [[ ! -x "$SERVER_BIN" ]]; then
    err "server binary not found: $SERVER_BIN"
    err "is CLIO installed? run the installer or set CLIO_PREFIX."
    return 1
  fi
  say "Starting CLIO server on :$CLIO_PORT (log: $SERVER_LOG)"
  # setsid runs the server as its own session/process-group leader (PGID == PID)
  # so stop_server can group-kill the server AND every MCP child it spawns (the
  # uvx stdio servers) instead of orphaning them. It also detaches from the
  # controlling terminal (replaces nohup); stdin from /dev/null so the daemon
  # never blocks on a read.
  (
    cd "$CLIO_PREFIX/clio-agent" &&
    exec setsid "$SERVER_BIN" --port "$CLIO_PORT" >"$SERVER_LOG" 2>&1 </dev/null
  ) &
  echo $! >"$PIDFILE"
  SERVER_WAS_STARTED=1
  # First-run startup is slow (ARC/LSM init + MCP server spawn) and can take
  # 30-60s; only fail after a generous window so a healthy-but-slow start isn't
  # reported as a failure (the server keeps coming up in the background anyway).
  local i
  for i in $(seq 1 180); do
    if health; then say "  healthy (pid $(cat "$PIDFILE" 2>/dev/null || echo '?'))"; return 0; fi
    sleep 0.5
  done
  err "server did not become healthy in ~90s - check $SERVER_LOG"
  return 1
}

stop_server() {
  local p
  p="$(server_pid || true)"
  if [[ -z "$p" ]]; then
    say "no CLIO server running"
    rm -f "$PIDFILE"
    return 0
  fi
  say "Stopping CLIO server (pid $p) and its MCP children"
  # Group-kill: the server leads its own process group (started via setsid), so its
  # MCP subprocess children (uvx stdio servers) share the group. Signal the whole
  # group (negative PID) so none are orphaned. Fall back to a plain PID kill for a
  # server started outside this launcher (not a group leader).
  kill -TERM -"$p" 2>/dev/null || kill -TERM "$p" 2>/dev/null || true
  local i
  for i in $(seq 1 20); do
    kill -0 "$p" 2>/dev/null || break
    sleep 0.25
  done
  if kill -0 "$p" 2>/dev/null; then
    warn "  did not exit - force killing the process group"
    kill -9 -"$p" 2>/dev/null || kill -9 "$p" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
  say "  stopped"
}

status_server() {
  local p health_txt
  p="$(server_pid || true)"
  if health; then health_txt="healthy"; else health_txt="not responding"; fi
  echo "prefix:  $CLIO_PREFIX"
  echo "port:    $CLIO_PORT"
  if [[ -n "$p" ]]; then echo "pid:     $p"; else echo "pid:     (none)"; fi
  echo "health:  $health_txt"
  echo "server:  $SERVER_LOG"
  echo "gact:    $GACT_LOG"
}

show_logs() {
  local n="${1:-40}"
  local files=()
  [[ -f "$SERVER_LOG" ]] && files+=("$SERVER_LOG")
  [[ -f "$GACT_LOG" ]] && files+=("$GACT_LOG")
  if [[ ${#files[@]} -eq 0 ]]; then
    warn "no logs yet (server hasn't run, or different CLIO_PREFIX)"
    return 0
  fi
  tail -n "$n" -F "${files[@]}"
}

doctor() {
  local ok=0
  echo "CLIO doctor"
  echo "  prefix:       $CLIO_PREFIX"
  printf "  server bin:   "; if [[ -x "$SERVER_BIN" ]]; then echo "ok"; else echo "MISSING"; ok=1; fi
  printf "  gact bin:     "; if [[ -x "$GACT_BIN" ]]; then echo "ok"; else echo "MISSING"; ok=1; fi
  printf "  curl:         "; if command -v curl >/dev/null 2>&1; then echo "ok"; else echo "MISSING"; ok=1; fi
  printf "  port :%s:  " "$CLIO_PORT"; if health; then echo "server healthy"; else echo "free / no server"; fi
  printf "  launcher:     "; if [[ -e "$CLIO_BIN_DIR/clio" ]]; then echo "$CLIO_BIN_DIR/clio"; else echo "not in $CLIO_BIN_DIR"; fi
  return $ok
}

# report prints a diagnostics bundle suitable for pasting into a GitHub
# issue: versions, environment, health, and the tail of every log.
report() {
  echo "==== CLIO bug report ===="
  echo "date:       $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "os:         $(uname -srm)"
  echo "prefix:     $CLIO_PREFIX"
  echo "port:       $CLIO_PORT"
  if [[ -x "$GACT_BIN" ]]; then
    echo "gact:       $("$GACT_BIN" version 2>/dev/null | head -n1)"
  else
    echo "gact:       (binary missing)"
  fi
  if [[ -f "$CLIO_PREFIX/clio-agent/pyproject.toml" ]]; then
    echo "clio-agent: $(grep -m1 '^version' "$CLIO_PREFIX/clio-agent/pyproject.toml" 2>/dev/null || true)"
  fi
  if health; then echo "health:     healthy"; else echo "health:     not responding"; fi
  local lf
  for lf in "$SERVER_LOG" "$GACT_LOG"; do
    echo ""
    echo "---- $lf (last 40 lines) ----"
    if [[ -f "$lf" ]]; then tail -n 40 "$lf"; else echo "(none)"; fi
  done
  echo ""
  echo "==== end report ===="
}

completion() {
  local cmds="web start stop restart status ps logs doctor report completion uninstall attach help"
  case "${1:-}" in
    bash)
      cat <<EOF
_clio() {
  COMPREPLY=( \$(compgen -W "$cmds" -- "\${COMP_WORDS[COMP_CWORD]}") )
}
complete -F _clio clio
EOF
      ;;
    zsh)
      cat <<EOF
#compdef clio
_clio() {
  local -a cmds
  cmds=($cmds)
  _describe 'command' cmds
}
_clio "\$@"
EOF
      ;;
    *)
      err "usage: clio completion bash|zsh"
      return 2
      ;;
  esac
}

# usage prints the leading comment block as help text - reads until the
# first non-comment line so it stays correct as the header grows.
usage() {
  awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    ""|attach)
      shift || true
      update_check
      start_server
      # Lifecycle: if THIS invocation started the server, tie its lifetime to the
      # TUI — stop the server (and its MCP children) when the TUI exits, so closing
      # the TUI closes the clio it launched. If a server was ALREADY running
      # (someone ran `clio start` — i.e. deliberately detached/shared), leave it
      # untouched and just attach.
      # stdout stays on the terminal so the TUI renders; gact stderr is captured to
      # a log so Go panics survive for bug reports.
      if [[ "${SERVER_WAS_STARTED:-0}" = 1 ]]; then
        trap 'exit 130' INT TERM
        trap 'stop_server' EXIT
        env \
          GACT_BACKEND="http://127.0.0.1:$CLIO_PORT" \
          GACT_BRAND_NAME="$CLIO_BRAND_NAME" \
          "$GACT_BIN" "$@" 2>"$GACT_LOG" || true
      else
        exec env \
          GACT_BACKEND="http://127.0.0.1:$CLIO_PORT" \
          GACT_BRAND_NAME="$CLIO_BRAND_NAME" \
          "$GACT_BIN" "$@" 2>"$GACT_LOG"
      fi
      ;;
    web|--web)
      shift || true
      local web_dev=0 arg
      for arg in "$@"; do [[ "$arg" == "--dev" ]] && web_dev=1; done
      if (( web_dev )); then
        # --dev: build + serve the web app from your working checkout instead of
        # the installed bundle, so `clio --web --dev` shows what you're building.
        local src
        if ! src="$(resolve_web_src)"; then
          err "clio --web --dev: set CLIO_WEB_SRC to your gact-tui/apps checkout (none auto-detected)"
          return 1
        fi
        command -v pnpm >/dev/null 2>&1 || { err "clio --web --dev needs pnpm on PATH to build the web"; return 1; }
        if [[ "${CLIO_WEB_NO_BUILD:-0}" != 1 ]]; then
          say "building dev web bundle from $src (set CLIO_WEB_NO_BUILD=1 to skip)"
          ( cd "$src" && pnpm --filter @clio/web build ) || { err "dev web build failed"; return 1; }
        fi
        export CLIO_WEB_DIR="$src/web/dist"
        [[ -f "$CLIO_WEB_DIR/index.html" ]] || { err "no built web at $CLIO_WEB_DIR (run without CLIO_WEB_NO_BUILD)"; return 1; }
        say "serving DEV web bundle from $CLIO_WEB_DIR"
      fi
      if [[ ! -f "$WEB_DIR/index.html" && -z "${CLIO_WEB_DIR:-}" ]]; then
        err "web bundle not found at $WEB_DIR"
        err "reinstall CLIO with the web bundle, or set CLIO_WEB_DIR to a built web dist"
        return 1
      fi
      export CLIO_WEB_DIR="${CLIO_WEB_DIR:-$WEB_DIR}"
      # The web mount is wired at server startup, so a server already running
      # WITHOUT the web bundle (or serving a DIFFERENT bundle, e.g. switching to
      # --dev) must be restarted to pick up this CLIO_WEB_DIR.
      if health && { ! serving_web || (( web_dev )); }; then
        say "restarting server in web mode"
        stop_server
      fi
      start_server
      url="http://127.0.0.1:$CLIO_PORT/"
      say "CLIO web UI: $url"
      open_url "$url"
      ;;
    desktop|--desktop)
      shift || true
      local dt_dev=0 arg
      for arg in "$@"; do [[ "$arg" == "--dev" ]] && dt_dev=1; done
      start_server
      if (( dt_dev )); then
        local src
        if ! src="$(resolve_web_src)"; then
          err "clio --desktop --dev: set CLIO_WEB_SRC to your gact-tui/apps checkout (none auto-detected)"
          return 1
        fi
        command -v pnpm >/dev/null 2>&1 || { err "clio --desktop --dev needs pnpm on PATH"; return 1; }
        say "launching desktop dev shell (tauri dev) from $src against :$CLIO_PORT"
        exec env GACT_BACKEND="http://127.0.0.1:$CLIO_PORT" \
          sh -c "cd '$src' && pnpm --filter @clio/desktop tauri:dev"
      fi
      local dt_bin="${CLIO_DESKTOP_BIN:-}"
      if [[ -z "$dt_bin" || ! -x "$dt_bin" ]]; then
        err "clio --desktop: no installed desktop app found"
        err "set CLIO_DESKTOP_BIN to the built binary, or use 'clio --desktop --dev' for the Tauri dev shell"
        return 1
      fi
      say "launching desktop app: $dt_bin"
      exec "$dt_bin"
      ;;
    start)        update_check; start_server ;;
    stop)         stop_server ;;
    restart)      stop_server; start_server ;;
    update)
      shift || true
      local uv_bin
      uv_bin="$(command -v uv 2>/dev/null || true)"
      [[ -z "$uv_bin" && -x "$CLIO_VENV/bin/uv" ]] && uv_bin="$CLIO_VENV/bin/uv"
      say "updating clio-agent to the latest PyPI release"
      if health; then say "stopping the running server first"; stop_server; fi
      if [[ -n "$uv_bin" ]]; then
        "$uv_bin" pip install --python "$CLIO_VENV/bin/python" -U clio-agent || { err "update failed"; return 1; }
      else
        "$CLIO_VENV/bin/python" -m pip install -U clio-agent || { err "update failed (no uv; pip fallback also failed)"; return 1; }
      fi
      rm -f "$UPDATE_STAMP" 2>/dev/null || true
      say "updated — run 'clio' to start the new version"
      ;;
    status|ps)    status_server ;;
    logs)         shift || true; show_logs "${1:-40}" ;;
    doctor)       doctor ;;
    report)       report ;;
    completion)   shift || true; completion "${1:-}" ;;
    uninstall)
      shift || true
      local un="$CLIO_PREFIX/uninstall.sh"
      [[ -x "$un" ]] || un="$CLIO_PREFIX/clio-agent/install/uninstall.sh"
      if [[ -x "$un" ]]; then exec "$un" "$@"; fi
      err "uninstaller not found (looked in $CLIO_PREFIX and the clio-agent checkout)"
      return 1
      ;;
    help|-h|--help) usage ;;
    *)
      err "unknown command: $cmd"
      usage
      return 2
      ;;
  esac
}

main "$@"
