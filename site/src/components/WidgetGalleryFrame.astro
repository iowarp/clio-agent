<div class="widget-gallery-doc">
	<iframe
		class="widget-gallery-frame"
		src="/widgets/widget-preview.html?embedded=1&section=linked"
		title="Interactive CLIO widget gallery"
		loading="eager"
		allow="clipboard-write"
	></iframe>
</div>
<dialog class="widget-skill-dialog" aria-label="Agent guidance or component contract">
	<iframe title="Agent guidance or component contract" loading="lazy"></iframe>
</dialog>

<script>
	const frame = document.querySelector<HTMLIFrameElement>('.widget-gallery-frame');
	const skillDialog = document.querySelector<HTMLDialogElement>('.widget-skill-dialog');
	const skillFrame = skillDialog?.querySelector('iframe');
	window.addEventListener('message', (event) => {
		if (event.origin !== window.location.origin) return;
		const message = event.data as { type?: string; name?: string };
		if (message?.type === 'clio:gallery-skill' && event.source === frame?.contentWindow && skillDialog && skillFrame) {
			const name = message.name ?? 'general';
			skillFrame.src = `/widgets/widget-preview.html?embedded=1&skill=${encodeURIComponent(name)}`;
			skillDialog.showModal();
		} else if (message?.type === 'clio:gallery-skill-close' && event.source === skillFrame?.contentWindow) {
			skillDialog?.close();
		}
	});
	skillDialog?.addEventListener('close', () => { if (skillFrame) skillFrame.src = 'about:blank'; });
	skillFrame?.addEventListener('load', () => {
		skillFrame.contentWindow?.postMessage({
			type: 'clio:gallery-theme',
			theme: document.documentElement.dataset.theme === 'light' ? 'light' : 'dark',
		}, window.location.origin);
	});
	frame?.addEventListener('load', () => {
		const page = frame.contentDocument;
		if (!page) return;
		const syncTheme = () => {
			frame.contentWindow?.postMessage({
				type: 'clio:gallery-theme',
				theme: document.documentElement.dataset.theme === 'light' ? 'light' : 'dark',
			}, window.location.origin);
		};
		new MutationObserver(syncTheme).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});
		syncTheme();
		const content = page.getElementById('root');
		const resize = () => {
			frame.style.height = `${Math.max(
				650,
				page.documentElement.scrollHeight,
				page.body.scrollHeight,
				content?.scrollHeight ?? 0,
			) + 4}px`;
		};
		const observer = new ResizeObserver(resize);
		observer.observe(page.documentElement);
		observer.observe(page.body);
		if (content) observer.observe(content);
		resize();
	});
</script>
