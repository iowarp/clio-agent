---
/**
 * The one site header, used by the home page and inside Starlight's header on
 * docs pages. It carries its own palette so both kinds of page draw it the
 * same, and the browser keeps it in place across page changes.
 *
 * Search: on docs pages the button opens Starlight's search dialog; on the
 * home page it links to the docs with ?search, which opens the same dialog.
 */
import ThemeSwitch from './ThemeSwitch.astro';
import { primaryNav, isActiveNav } from '../lib/nav';

interface Props {
	/** Stick to the top of the page; docs pages already sit in a fixed header. */
	sticky?: boolean;
}

const { sticky = false } = Astro.props;
const path = Astro.url.pathname;
const home = path === '/' || path === '/index.html';
const GITHUB = 'https://github.com/iowarp/clio-agent';
---

<header class="sh" id="top-nav" data-sticky={sticky || undefined}>
	<div class="sh-wrap">
		<a class="sh-brand" href="/" aria-label="CLIO home">
			<img src="/clio-mark-small.svg" alt="" width="36" height="36" />
			<span>CLIO</span>
		</a>
		<nav aria-label="Main">
			<ul class="sh-links">
				{
					primaryNav.map((item) => (
						<li data-item={item.label}>
							<a href={item.href} aria-current={isActiveNav(item, path) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a class="sh-search" href="/docs/?search" data-site-search aria-label="Search the docs">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
			<span>Search</span>
			<kbd>Ctrl K</kbd>
		</a>
		<div class="sh-end">
			<a class="sh-icon" href={GITHUB} aria-label="CLIO on GitHub">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
					><path
						d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
					></path></svg
				>
			</a>
			<ThemeSwitch />
			<a class="sh-download" href={home ? '#download' : '/#download'}>Download</a>
		</div>
	</div>
</header>

<script>
	// On docs pages, open Starlight's search dialog in place.
	const starlightSearch = () =>
		document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
	const link = document.querySelector<HTMLAnchorElement>('[data-site-search]');
	link?.addEventListener('click', (event) => {
		const button = starlightSearch();
		if (!button) return;
		event.preventDefault();
		// Starlight closes its dialog on any link click that reaches window.
		event.stopPropagation();
		button.click();
	});
	// Starlight already binds Ctrl K on docs pages; elsewhere it goes to the docs search.
	window.addEventListener('keydown', (event) => {
		if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== 'k') return;
		if (starlightSearch() || !link) return;
		event.preventDefault();
		location.href = link.href;
	});
</script>

<style is:global>
	/* Moving between pages swaps the content in place; the header stays put. */
	@view-transition {
		navigation: auto;
	}
	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: 140ms;
	}
	::view-transition-group(site-header) {
		animation: none;
	}
	@media (prefers-reduced-motion: reduce) {
		::view-transition-group(*),
		::view-transition-old(*),
		::view-transition-new(*) {
			animation: none !important;
		}
	}
</style>

<style>
	.sh {
		--sh-paper: #fbfdfd;
		--sh-paper-2: #f2f6f7;
		--sh-ink: #10263b;
		--sh-ink-2: #3c5568;
		--sh-soft: #6b7f8e;
		--sh-line: #d9e2e6;
		--sh-line-strong: #b9c8cf;
		--sh-accent: #2f7599;
		--sh-cta: #143b5d;
		--sh-cta-hover: #0e2c47;
		--sh-cta-fg: #ffffff;
		--sh-gutter: clamp(20px, 3.4vw, 72px);

		/* The theme switch reads these names on both kinds of page. */
		--ink: var(--sh-ink);
		--ink-soft: var(--sh-soft);
		--line: var(--sh-line);
		--paper-sunk: var(--sh-paper-2);
		--paper-raised: #ffffff;

		box-sizing: border-box;
		width: 100%;
		height: 64px;
		background: color-mix(in srgb, var(--sh-paper) 88%, transparent);
		backdrop-filter: saturate(1.4) blur(10px);
		border-bottom: 1px solid var(--sh-line);
		color: var(--sh-ink);
		font-family: 'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
		view-transition-name: site-header;
	}
	:global(:root[data-theme='dark']) .sh {
		--sh-paper: #0c1823;
		--sh-paper-2: #13222f;
		--sh-ink: #eaf0f3;
		--sh-ink-2: #b6c4ce;
		--sh-soft: #8597a5;
		--sh-line: #223646;
		--sh-line-strong: #35506a;
		--sh-accent: #6aaed0;
		--sh-cta: #eaf0f3;
		--sh-cta-hover: #ffffff;
		--sh-cta-fg: #0c1823;
		--paper-raised: #1a2c3b;
	}
	.sh *,
	.sh *::before,
	.sh *::after {
		box-sizing: border-box;
	}
	.sh[data-sticky] {
		position: sticky;
		top: 0;
		z-index: 30;
	}
	.sh-wrap {
		display: flex;
		align-items: center;
		gap: 32px;
		width: 100%;
		max-width: 1760px;
		height: 100%;
		margin: 0 auto;
		padding: 0 var(--sh-gutter);
	}
	.sh a {
		color: inherit;
		text-decoration: none;
	}
	.sh-brand {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 10px;
	}
	.sh-brand img {
		display: block;
		width: 36px;
		height: 36px;
	}
	.sh-brand span {
		font-size: 22px;
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1;
	}
	.sh nav {
		min-width: 0;
	}
	.sh-links {
		display: flex;
		gap: 24px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 15px;
		line-height: 1.5;
	}
	.sh-links li {
		margin: 0;
	}
	.sh-links a {
		display: inline-block;
		padding-block: 0.4rem;
		border-bottom: 1px solid transparent;
		color: var(--sh-ink-2);
		white-space: nowrap;
	}
	.sh-links a:hover {
		color: var(--sh-ink);
	}
	.sh-links a[aria-current='page'] {
		color: var(--sh-ink);
		border-bottom-color: var(--sh-accent);
	}
	.sh-search {
		display: flex;
		flex: 0 1 22rem;
		align-items: center;
		gap: 10px;
		min-width: 0;
		height: 40px;
		padding: 0 8px 0 14px;
		border: 1px solid var(--sh-line);
		border-radius: 10px;
		color: var(--sh-soft) !important;
		font-size: 15px;
		transition: border-color 0.15s ease;
	}
	.sh-search:hover {
		border-color: var(--sh-line-strong);
		color: var(--sh-ink-2) !important;
	}
	.sh-search svg {
		flex: none;
	}
	.sh-search span {
		flex: 1;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.sh-search kbd {
		flex: none;
		padding: 2px 6px;
		border: 1px solid var(--sh-line);
		border-radius: 6px;
		background: var(--sh-paper-2);
		color: inherit;
		font: 500 12px/1.4 'IBM Plex Sans', system-ui, sans-serif;
	}
	.sh-end {
		display: flex;
		flex: none;
		align-items: center;
		gap: 12px;
		margin-left: auto;
	}
	.sh-icon {
		display: inline-grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 9px;
		color: var(--sh-ink-2) !important;
	}
	.sh-icon:hover {
		background: var(--sh-paper-2);
		color: var(--sh-ink) !important;
	}
	.sh-download {
		display: inline-flex;
		align-items: center;
		min-height: 38px;
		padding: 0 16px;
		border-radius: 9px;
		background: var(--sh-cta);
		color: var(--sh-cta-fg) !important;
		font-size: 15px;
		font-weight: 500;
		white-space: nowrap;
		transition: background 0.15s ease;
	}
	.sh-download:hover {
		background: var(--sh-cta-hover);
	}

	/* Search folds to an icon before anything else is dropped. */
	@media (max-width: 1180px) {
		.sh-wrap {
			gap: 24px;
		}
		.sh-search {
			flex: none;
			justify-content: center;
			width: 40px;
			padding: 0;
		}
		.sh-search span,
		.sh-search kbd {
			display: none;
		}
	}
	@media (max-width: 900px) {
		.sh-icon {
			display: none;
		}
		.sh-links {
			gap: 18px;
		}
	}
	@media (max-width: 720px) {
		.sh-wrap {
			gap: 14px;
			padding: 0 16px;
		}
		.sh-brand span,
		.sh-links [data-item='Overview'],
		.sh-links [data-item="What's new"] {
			display: none;
		}
		.sh-end {
			gap: 8px;
		}
		.sh-end :global(.theme-switch) {
			display: none;
		}
		.sh-download {
			padding: 0 12px;
		}
	}
	@media (max-width: 420px) {
		.sh-links [data-item='Examples'] {
			display: none;
		}
	}
	/* Docs on phones: leave room for Starlight's menu button, which takes the place of Download. */
	@media (max-width: 49.99rem) {
		:global([data-has-sidebar]) .sh-wrap {
			padding-right: 60px;
		}
		:global([data-has-sidebar]) .sh-download {
			display: none;
		}
	}
</style>
