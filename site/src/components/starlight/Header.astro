---
/**
 * Docs header: the same SiteHeader as the home page. Starlight's search stays
 * mounted, out of sight, so the header's search button and Ctrl K open its
 * dialog.
 */
import Search from '@astrojs/starlight/components/Search.astro';
import SiteHeader from '../SiteHeader.astro';
import MobileDocsIndex from './MobileDocsIndex.astro';
---

<SiteHeader />
<div class="starlight-search print:hidden">
	<Search />
</div>

<MobileDocsIndex />

<script>
	// The home page search links here with ?search; open the same search dialog.
	const params = new URLSearchParams(location.search);
	if (params.has('search')) {
		params.delete('search');
		const rest = params.toString();
		history.replaceState(null, '', location.pathname + (rest ? `?${rest}` : '') + location.hash);
		customElements.whenDefined('site-search').then(() => {
			document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
		});
	}
</script>

<style>
	/* The dialog opens in the top layer, so hiding its trigger leaves the dialog visible. */
	.starlight-search {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
