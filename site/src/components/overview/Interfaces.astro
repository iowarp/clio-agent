---
/**
 * Where CLIO runs. The desktop app leads; the same workspace also opens in a
 * browser or a container. Commands come from install/clio and docker-compose.yml.
 */
import { ArrowRight, Container, Globe, Monitor } from 'lucide-react';
import { Frame, FramePanel } from '@/components/reui/frame';
import { IconTile } from '@/components/reui/icon-tile';
import SectionHeading from './SectionHeading.astro';
import InstallTabs from './InstallTabs';
import Command from './Command';
import { release } from '@/lib/release';
---

<section class="interfaces not-content" aria-labelledby="interfaces">
	<SectionHeading
		id="interfaces"
		label="Interfaces"
		title="Start with the"
		emphasis="desktop app."
		lede="The desktop app is the simplest way to use CLIO. On a server or a shared machine, open the same workspace in a browser or run it in a container."
	/>

	<div class="grid">
		<Frame className="desktop">
			<FramePanel className="flex h-full flex-col gap-3">
				<IconTile variant="soft"><Monitor /></IconTile>
				<h3>Desktop app</h3>
				<p>
					Installers for Windows, macOS, and Linux. The recommended build includes the CLIO backend and starts it
					for you, keeps running in the system tray when you close the window, and updates itself from each release.
				</p>
				<a class="link" href="#download">Download the desktop app <ArrowRight aria-hidden="true" size={16} /></a>
			</FramePanel>
		</Frame>

		<Frame>
			<FramePanel className="flex h-full flex-col gap-3">
				<IconTile variant="soft"><Globe /></IconTile>
				<h3>In your browser</h3>
				<p>Install CLIO with one command, then open the workspace in your browser.</p>
				<InstallTabs client:visible />
				<p class="after">
					Then run <code>clio --web</code>. It opens <code>http://127.0.0.1:17800</code>.
				</p>
			</FramePanel>
		</Frame>

		<Frame>
			<FramePanel className="flex h-full flex-col gap-3">
				<IconTile variant="soft"><Container /></IconTile>
				<h3>Docker</h3>
				<p>The web image bundles CLIO and the workspace interface.</p>
				<Command client:visible command={`docker run --rm -p 8080:80 ${release.webImage}`} />
				<p class="after">Open <code>http://localhost:8080</code>.</p>
			</FramePanel>
		</Frame>

	</div>
	<p class="also">
		Prefer the keyboard? After the install script, <code>clio</code> opens a terminal interface. See the
		<a href="/docs/cli/">command-line reference</a>.
	</p>
</section>

<style>
	.interfaces {
		padding-block: clamp(4rem, 8vw, 6rem);
		border-top: 1px solid var(--line);
	}
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		margin-top: 2.5rem;
	}
	@media (min-width: 56rem) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.grid > :global(.desktop) {
			grid-column: 1 / -1;
		}
	}
	.also {
		margin-top: 1.5rem;
		font-size: var(--sl-text-sm);
		color: var(--muted);
	}
	.also a {
		color: var(--ink-soft);
	}
	h3 {
		margin: 0.25rem 0 0;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.5rem;
		color: var(--ink);
	}
	p {
		margin: 0;
		line-height: 1.6;
		color: var(--ink-soft);
	}
	.after {
		font-size: var(--sl-text-sm);
		color: var(--muted);
	}
	code {
		font-family: var(--font-code);
		font-size: 0.9em;
		color: var(--ink);
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: auto;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}
	.link:hover {
		text-decoration: underline;
	}
</style>
