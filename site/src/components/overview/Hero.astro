---
/**
 * Overview hero. Replaces Starlight's Hero component; Starlight renders it
 * only on pages whose frontmatter sets `hero`, which is the overview alone.
 */
import { ArrowRight, Container, Globe, Monitor } from 'lucide-react';
import HeroDownload from './HeroDownload';
import { release } from '@/lib/release';

const surfaces = [
	{ icon: Monitor, label: 'Desktop app', href: '#download' },
	{ icon: Globe, label: 'In your browser', href: '#interfaces' },
	{ icon: Container, label: 'Docker', href: '#interfaces' },
];
---

<section class="ov-hero not-content" aria-labelledby="_top">
	<div class="copy">
		<p class="eyebrow">
			<span>Open source</span>
			<span class="sep" aria-hidden="true">/</span>
			<a href={release.notesUrl}>{release.tag}</a>
		</p>
		<h1 id="_top">Analyze your data.<br /><em>Keep the evidence.</em></h1>
	</div>
	<div class="intro">
		<p class="lede">
			CLIO is an open-source AI workspace for scientific data. Ask a question, explore the results,
			and inspect the files and steps behind the answer. Run it on your computer with the models you choose.
		</p>
		<div class="actions">
			<HeroDownload client:load />
			<a class="secondary" href="/docs/">Read the docs <ArrowRight aria-hidden="true" size={18} /></a>
		</div>
		<ul class="surfaces" aria-label="Where CLIO runs">
			{
				surfaces.map(({ icon: Icon, label, href }) => (
					<li>
						<a href={href}>
							<Icon aria-hidden="true" size={16} />
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.ov-hero {
		display: grid;
		gap: 1.75rem 3rem;
		align-items: center;
		padding-block: clamp(2rem, 5vw, 4rem) 2rem;
	}
	@media (min-width: 64rem) {
		.ov-hero {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		}
	}
	.eyebrow {
		display: flex;
		gap: 0.6rem;
		align-items: baseline;
		margin: 0 0 1rem;
		font-family: var(--font-code);
		font-size: var(--sl-text-sm);
		color: var(--muted);
	}
	.eyebrow a {
		color: var(--muted);
		text-decoration: none;
	}
	.eyebrow a:hover {
		color: var(--accent);
	}
	h1 {
		margin: 0;
		max-width: 22ch;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.6rem, 5vw, 4.1rem);
		line-height: 1.08;
		letter-spacing: -0.02em;
		color: var(--ink);
	}
	h1 em {
		color: var(--accent);
		font-style: italic;
	}
	.lede {
		max-width: 38rem;
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.55;
		color: var(--ink-soft);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		align-items: flex-start;
		margin-top: 1.25rem;
	}
	.secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.75rem;
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
	}
	.secondary :global(svg) {
		color: var(--accent);
		transition: transform var(--motion-fast) var(--motion-ease);
	}
	.secondary:hover :global(svg) {
		transform: translateX(3px);
	}
	.surfaces {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 1rem 0 0;
		padding: 1rem 0 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}
	.surfaces a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--ink-soft);
		text-decoration: none;
	}
	.surfaces a:hover {
		color: var(--ink);
	}
	.surfaces :global(svg) {
		color: var(--muted);
	}
</style>
