---
/** Supported model providers, grouped. Source: src/clio_agent/providers/catalog.py. */
import { ArrowRight } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import { modelGroups } from '@/data/overview';
---

<section class="models not-content" aria-labelledby="models">
	<SectionHeading
		id="models"
		label="Models"
		title="Use the models"
		emphasis="you already trust."
		lede="Pick a provider when CLIO first starts, and change it any time from Settings. Each session can use a different model."
	/>
	<div class="groups">
		{
			modelGroups.map((group) => (
				<div class="group">
					<h3>{group.title}</h3>
					<p class="detail">{group.detail}</p>
					<ul>
						{group.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
	<a class="more" href="/docs/connect-a-model/">Connect a model <ArrowRight aria-hidden="true" size={16} /></a>
</section>

<style>
	.models {
		padding-block: clamp(4rem, 8vw, 6rem);
		border-top: 1px solid var(--line);
	}
	.groups {
		display: grid;
		gap: 2rem;
		margin-top: 2.5rem;
	}
	@media (min-width: 48rem) {
		.groups {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 72rem) {
		.groups {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.group {
		padding-top: 1rem;
		border-top: 1px solid var(--line-control);
	}
	h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		color: var(--ink);
	}
	.detail {
		margin: 0.25rem 0 1rem;
		font-size: var(--sl-text-sm);
		color: var(--muted);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
		color: var(--ink-soft);
	}
	.more {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 2.5rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}
	.more :global(svg) {
		color: var(--accent);
	}
</style>
